@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026 AERA | Erez Yaary
+"""BADGECMP.PRG (make prg) on one of the family's machines: badge_draw
+against the VDI's own drawing of the same badge, byte for byte, and the
+times. Exit 1 when a badge differs.
+
+    run.py WORK MACHINE [--nvdi]
+"""
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "speed"))
+import speed  # noqa: E402
+
+a = [x for x in sys.argv[1:] if not x.startswith("--")]
+if len(a) < 2:
+    sys.exit(__doc__)
+r = speed.Rig(a[0], a[1], nvdi="--nvdi" in sys.argv, display=":93")
+bad = 1
+try:
+    r.put(os.path.join(HERE, "build", "atari", "BADGECMP.PRG"))
+    r.start("C:\\BADGECMP.PRG", ready="BDG done", boot=900)
+    print("badges on", r.describe())
+    for l in r.console().splitlines():
+        if l.startswith("BDG ") and l != "BDG done":
+            print("  " + l[4:])
+            if l == "BDG all the same":
+                bad = 0
+finally:
+    r.stop()
+sys.exit(bad)
diff --git a/common/tests/badge/test_badge.c b/common/tests/badge/test_badge.c
new file mode 100644
index 0000000..da7b181
--- /dev/null
+++ b/common/tests/badge/test_badge.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (C) 2026 AERA | Erez Yaary */
+/*
+ * test_badge.c - badge_form (ui/badge.c) on the build machine: the box a
+ * pixel round the text, 3 left and 2 right, each glyph where it goes from
+ * a font laid out as TOS's (glyphs side by side in rows of fw bytes), the
+ * characters the font hasn't left blank, the limits, and the box alone
+ * with no font or another height. With AddressSanitizer: make test
+ */
+#include <stdio.h>
+#include <string.h>
+#include "badge.h"
+
+static int fails;
+
+static void check(int ok, const char *what)
+{
+	printf("%s %s\n", ok ? "ok  " : "FAIL", what);
+	fails += !ok;
+}
+
+static int px(const BADGE *b, int x, int y)
+{
+	return (b->bits[y * BADGE_WPL + (x >> 4)] >> (15 - (x & 15))) & 1;
+}
+
+/* a 6 x 6 font of '0'..'9' and 'A'..'Z' (first 48, last 90): each glyph
+   5 columns wide (its 6th, the right, blank), the glyph's own number in
+   its first row as bits, a pixel at its column 4 on its last row */
+#define FIRST 48
+#define LAST 90
+#define NG (LAST - FIRST + 1)
+#define FW ((NG * 6 + 7) / 8)
+static unsigned char dat[FW * 6];
+static short off[NG + 1];
+
+static void fpx(int x, int y)
+{
+	dat[y * FW + x / 8] |= (unsigned char)(0x80 >> (x & 7));
+}
+
+static int glyph_px(int g, int x, int y)
+{
+	if (x >= 5)
+		return 0;
+	if (y == 0)
+		return (g >> x) & 1;
+	return y == 5 && x == 4;
+}
+
+int main(void)
+{
+	static BADGE b;
+	int g, x, y, bad;
+	for (g = 0; g <= NG; g++)
+		off[g] = (short)(g * 6);
+	for (g = 0; g < NG; g++)
+		for (y = 0; y < 6; y++)
+			for (x = 0; x < 6; x++)
+				if (glyph_px(g, x, y))
+					fpx(g * 6 + x, y);
+
+	check(badge_form(&b, "44.1 KHZ", 6, 6, FIRST, LAST, off, dat, FW, 6) == 1 && b.glyphs,
+	      "made with its glyphs");
+	check(b.w == 8 * 6 + 5 && b.h == 10 && !strcmp(b.s, "44.1 KHZ"), "the box 53 x 10, its text kept");
+	bad = 0;
+	for (x = 0; x < b.w; x++)
+		bad += !px(&b, x, 0) || !px(&b, x, b.h - 1);
+	for (y = 0; y < b.h; y++)
+		bad += !px(&b, 0, y) || !px(&b, b.w - 1, y);
+	for (x = b.w; x < BADGE_WPL * 16; x++)
+		for (y = 0; y < BADGE_ROWS; y++)
+			bad += px(&b, x, y);
+	for (y = b.h; y < BADGE_ROWS; y++)
+		for (x = 0; x < BADGE_WPL * 16; x++)
+			bad += px(&b, x, y);
+	check(!bad, "the box's lines, nothing outside it");
+	bad = 0;
+	{
+		const char *s = "44.1 KHZ";
+		int i;
+		for (i = 0; s[i]; i++) {
+			int c = (unsigned char)s[i];
+			for (y = 0; y < 6; y++)
+				for (x = 0; x < 6; x++) {
+					int want = c >= FIRST && c <= LAST ? glyph_px(c - FIRST, x, y) : 0;
+					bad += px(&b, 3 + i * 6 + x, 2 + y) != want;
+				}
+		}
+		/* the clear pixel round the text: row 1, the last but one, columns 1-2, w-2 */
+		for (x = 1; x < b.w - 1; x++)
+			bad += px(&b, x, 1) || px(&b, x, b.h - 2);
+		for (y = 1; y < b.h - 1; y++)
+			bad += px(&b, 1, y) || px(&b, 2, y) || px(&b, b.w - 2, y);
+	}
+	check(!bad, "each glyph in place, '.' and ' ' (not in the font) blank, a pixel clear all round");
+
+	check(badge_form(&b, "123456789012345678901", 6, 6, FIRST, LAST, off, dat, FW, 6) == 1 && b.w == 131,
+	      "21 characters fit (131 wide)");
+	check(!badge_form(&b, "1234567890123456789012", 6, 6, FIRST, LAST, off, dat, FW, 6) && !b.w,
+	      "22 don't: not made");
+	check(!badge_form(&b, "", 6, 6, FIRST, LAST, off, dat, FW, 6) && !b.w, "empty: not made");
+	check(!badge_form(&b, "DSP", 6, 6, 0, 0, 0, 0, 0, 0) && b.w == 23 && !b.glyphs && px(&b, 0, 0) &&
+	      !px(&b, 3, 2), "no font: the box alone, for the VDI's text");
+	check(!badge_form(&b, "DSP", 6, 7, FIRST, LAST, off, dat, FW, 6) && b.w == 23 && b.h == 11 && !b.glyphs,
+	      "a font of another height: the box alone");
+	check(!badge_form(&b, "DSP", 6, 9, FIRST, LAST, off, dat, FW, 6) && !b.w, "a cell over 8 high: not made");
+	check(!badge_form(&b, "123456789012345678901", 7, 6, FIRST, LAST, off, dat, FW, 6) && !b.w,
+	      "wider than the form: not made");
+	printf("%s\n", fails ? "FAILED" : "all passed");
+	return fails != 0;
+}
diff --git a/common/ui/badge.c b/common/ui/badge.c
new file mode 100644
index 0000000..3064e81
--- /dev/null
+++ b/common/ui/badge.c
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (C) 2026 AERA | Erez Yaary */
+/*
+ * badge.c - a small boxed label in the 6 x 6 font, one raster copy
+ * (badge.h). From EPlay's bar (0.27).
+ */
+#include <string.h>
+#include "badge.h"
+#ifndef BADGE_HOST
+#include "gem.h"
+#endif
+
+int badge_vdi;
+
+static void set(BADGE *b, short x, short y)
+{
+	if (x >= 0 && y >= 0 && x < BADGE_WPL * 16 && y < BADGE_ROWS)
+		b->bits[y * BADGE_WPL + (x >> 4)] |= (unsigned short)(0x8000u >> (x & 15));
+}
+
+int badge_form(BADGE *b, const char *s, short cw, short ch, short first, short last, const short *off,
+	       const unsigned char *dat, short fw, short fh)
+{
+	short n = (short)strlen(s), i, x, y;
+	b->w = 0;
+	b->glyphs = 0;
+	b->s[0] = 0;
+	if (n <= 0 || n > BADGE_MAX || cw <= 0 || ch <= 0)
+		return 0;
+	memset(b->bits, 0, sizeof(b->bits));
+	b->w = (short)(n * cw + 5);
+	b->h = (short)(ch + 4);
+	strcpy(b->s, s);
+	if (b->w > BADGE_WPL * 16 || b->h > BADGE_ROWS) {
+		b->w = 0;		/* too big for the form: badge_draw boxes it */
+		return 0;
+	}
+	for (x = 0; x < b->w; x++) {
+		set(b, x, 0);
+		set(b, x, (short)(b->h - 1));
+	}
+	for (y = 0; y < b->h; y++) {
+		set(b, 0, y);
+		set(b, (short)(b->w - 1), y);
+	}
+	if (!off || !dat || fh != ch || fw <= 0)
+		return 0;
+	for (i = 0; i < n; i++) {
+		short c = (unsigned char)s[i], g0, g1;
+		if (c < first || c > last)
+			continue;
+		g0 = off[c - first];
+		g1 = off[c - first + 1];
+		for (x = 0; x < g1 - g0 && x < cw; x++) {
+			short sx = (short)(g0 + x);
+			for (y = 0; y < fh; y++)
+				if (dat[(long)y * fw + (sx >> 3)] & (0x80 >> (sx & 7)))
+					set(b, (short)(3 + i * cw + x), (short)(2 + y));
+		}
+	}
+	b->glyphs = 1;
+	return 1;
+}
+
+#ifndef BADGE_HOST
+
+static short vh, back_h, scw, sch, gen = 1;
+
+static const unsigned char *const *line_a_fonts(void)
+{
+	register const unsigned char *const *f __asm__("a1");
+	__asm__ volatile(".dc.w 0xa000" : "=r"(f) : : "d0", "d1", "d2", "a0", "a2", "memory", "cc");
+	return f;
+}
+
+void badge_init(short vdi_h, short text_h)
+{
+	short a, b;
+	vh = vdi_h;
+	back_h = text_h;
+	gen++;
+	vst_height(vh, 4, &scw, &sch);
+	vst_height(vh, text_h, &a, &b);
+	if (scw <= 0 || sch <= 0) {
+		scw = a;
+		sch = b;
+	}
+}
+
+short badge_width(const char *s)
+{
+	return (short)(strlen(s) * scw + 5);
+}
+
+short badge_height(void)
+{
+	return (short)(sch + 4);
+}
+
+static void make(BADGE *b, const char *s)
+{
+	const unsigned char *hd = line_a_fonts()[0];	/* the 6 x 6 */
+	if (hd)
+		badge_form(b, s, scw, sch, *(const short *)(hd + 36), *(const short *)(hd + 38),
+			   *(const short *const *)(hd + 72), *(const unsigned char *const *)(hd + 76),
+			   *(const short *)(hd + 80), *(const short *)(hd + 82));
+	else
+		badge_form(b, s, scw, sch, 0, 0, 0, 0, 0, 0);
+	b->gen = gen;
+}
+
+static void copy(const BADGE *b, short x, short y, short pen, const short *clip)
+{
+	MFDB src, dst;
+	short pxy[8], colors[2], x1 = x, y1 = y, x2 = (short)(x + b->w - 1), y2 = (short)(y + b->h - 1);
+	if (clip) {
+		if (x1 < clip[0])
+			x1 = clip[0];
+		if (y1 < clip[1])
+			y1 = clip[1];
+		if (x2 > clip[2])
+			x2 = clip[2];
+		if (y2 > clip[3])
+			y2 = clip[3];
+		if (x1 > x2 || y1 > y2)
+			return;
+	}
+	memset(&src, 0, sizeof(src));
+	memset(&dst, 0, sizeof(dst));
+	src.fd_addr = (void *)b->bits;
+	src.fd_w = BADGE_WPL * 16;
+	src.fd_h = BADGE_ROWS;
+	src.fd_wdwidth = BADGE_WPL;
+	src.fd_nplanes = 1;
+	pxy[0] = (short)(x1 - x);
+	pxy[1] = (short)(y1 - y);
+	pxy[2] = (short)(x2 - x);
+	pxy[3] = (short)(y2 - y);
+	pxy[4] = x1;
+	pxy[5] = y1;
+	pxy[6] = x2;
+	pxy[7] = y2;
+	colors[0] = pen;
+	colors[1] = 0;
+	vrt_cpyfm(vh, 2, pxy, &src, &dst, colors);	/* transparent */
+}
+
+static void bar(short x, short y, short w, short h)
+{
+	short p[4];
+	p[0] = x;
+	p[1] = y;
+	p[2] = (short)(x + w - 1);
+	p[3] = (short)(y + h - 1);
+	vr_recfl(vh, p);
+}
+
+short badge_draw(BADGE *b, short x, short y, short rh, const char *s, short pen, const short *clip)
+{
+	short n = (short)strlen(s), w = (short)(n * scw + 5), h = (short)(sch + 4), by = (short)(y + (rh - h) / 2);
+	badge_vdi = 0;
+	if (n <= 0)
+		return 0;
+	if (n > BADGE_MAX) {
+		b->w = b->glyphs = 0;	/* longer than a form: the VDI's way */
+		b->s[0] = 0;
+	} else if (b->gen != gen || strcmp(b->s, s))
+		make(b, s);
+	if (b->w)
+		copy(b, x, by, pen, clip);
+	else {
+		/* too big for the form: the box the VDI's too */
+		badge_vdi = 1;
+		vsf_interior(vh, 1);
+		vsf_perimeter(vh, 0);
+		vsf_color(vh, pen);
+		bar(x, by, w, 1);
+		bar(x, (short)(by + h - 1), w, 1);
+		bar(x, by, 1, h);
+		bar((short)(x + w - 1), by, 1, h);
+	}
+	if (!b->glyphs) {
+		short a, c;
+		badge_vdi = 1;
+		vswr_mode(vh, 2);
+		vst_height(vh, 4, &a, &c);
+		vst_color(vh, pen);
+		vst_effects(vh, 0);
+		v_gtext_n(vh, (short)(x + 3), (short)(by + 2), s, n);
+		vst_height(vh, back_h, &a, &c);
+	}
+	return w;
+}
+
+#endif
diff --git a/common/ui/badge.h b/common/ui/badge.h
new file mode 100644
index 0000000..9df367d
--- /dev/null
+++ b/common/ui/badge.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (C) 2026 AERA | Erez Yaary */
+/*
+ * badge.h - a small boxed label in the system font's small size (6 x 6):
+ * "320 KBPS", "44.1 KHZ", "DSP" in EPlay's bar, the Hebrew keyboard's
+ * badge, so every app's badges look alike (the hub, 5 Nov 2026).
+ *
+ * The text a pixel clear of a one-pixel box all round (3 pixels left, 2
+ * right: the glyphs' blank column is their right one), the box centred
+ * in a row of height rh at y, all in one pen, the ground left as it is.
+ *
+ * TOS's VDI draws a 6-pixel font a glyph at a time, shifted, and setting
+ * its size each time costs more: a badge's picture was 5 to 10 ms slower
+ * that way on a stock Falcon (EPlay 0.27, the hub's speed rig). So a
+ * badge is made once, as its text changes, into a one-plane form from the
+ * font's own glyphs (Line-A's), box and all, and drawn with one raster
+ * copy. Where the font isn't as TOS's (another size, no Line-A font) the
+ * box is in the form still, and the text is the VDI's.
+ *
+ *     static BADGE b;
+ *     badge_init(vdi_h, the window's text height);   once, and after a
+ *                                                    change of screen
+ *     w = badge_draw(&b, x, y, rh, "44.1 KHZ", pen, clip);
+ *
+ * A badge made is one raster copy, transparent, and sets nothing. On the
+ * VDI's way (badge_vdi after the call) it sets the writing mode to
+ * transparent (2), the text's colour and effects (0), the height back to
+ * badge_init's, and for a box too big for the form the fill's interior,
+ * perimeter and colour: an app that keeps those in step forgets them.
+ */
+#ifndef AERA_BADGE_H
+#define AERA_BADGE_H
+
+#define BADGE_MAX 21			/* characters */
+#define BADGE_WPL 9			/* 144 pixels: 21 x 6 and the box */
+#define BADGE_ROWS 12			/* a cell of 8 at most and the box */
+
+typedef struct {
+	char s[BADGE_MAX + 3];
+	short w, h;			/* the box; 0: not made */
+	short glyphs;			/* the text is in the form */
+	short gen;			/* badge_init's it was made for */
+	unsigned short bits[BADGE_WPL * BADGE_ROWS];
+} BADGE;
+
+void badge_init(short vdi_h, short text_h);
+short badge_width(const char *s);		/* the box's */
+short badge_height(void);
+/* the badge's width; s empty: nothing drawn, 0. clip: x1, y1, x2, y2,
+   or 0 for none */
+short badge_draw(BADGE *b, short x, short y, short rh, const char *s, short pen, const short *clip);
+/* the last badge_draw used the VDI's way (its attributes set) */
+extern int badge_vdi;
+
+/* the form, from a font's glyphs (first..last, off, dat, fw, fh: the
+   font header's) at cw a character: 1 when the text is in it. With no
+   font (dat 0) the box alone. For badge_draw, and the host test */
+int badge_form(BADGE *b, const char *s, short cw, short ch, short first, short last, const short *off,
+	       const unsigned char *dat, short fw, short fh);
+
+#endif
