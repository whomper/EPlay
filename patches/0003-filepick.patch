diff --git a/common/src/dirlist.c b/common/src/dirlist.c
new file mode 100644
index 0000000..f8ff37e
--- /dev/null
+++ b/common/src/dirlist.c
@@ -0,0 +1,292 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (C) 2026 AERA | Erez Yaary */
+/*
+ * dirlist.c - a folder's entries for the family's file dialog (dirlist.h).
+ */
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include "dirlist.h"
+
+static const DL_TYPE all_files[1] = { { "All files", "" } };
+
+void dl_init(DLIST *d)
+{
+	memset(d, 0, sizeof(*d));
+	d->types = all_files;
+	d->ntypes = 1;
+	d->type = 0;
+	d->sort = DS_NAME;
+}
+
+void dl_types(DLIST *d, const DL_TYPE *t, int n)
+{
+	if (t && n > 0) {
+		d->types = t;
+		d->ntypes = n > DL_TYPES ? DL_TYPES : n;
+	} else {
+		d->types = all_files;
+		d->ntypes = 1;
+	}
+	d->type = 0;
+}
+
+void dl_free(DLIST *d)
+{
+	free(d->e);
+	free(d->view);
+	d->e = 0;
+	d->view = 0;
+	d->n = d->cap = d->nview = 0;
+}
+
+void dl_clear(DLIST *d)
+{
+	d->n = d->nview = 0;
+}
+
+static int up(int c)
+{
+	return c >= 'a' && c <= 'z' ? c - 32 : c;
+}
+
+int dl_add(DLIST *d, const char *name, long size, unsigned short date, unsigned short time, int dir)
+{
+	DENT *x;
+	if (!strcmp(name, ".") || !strcmp(name, ".."))
+		return 1;
+	if (d->n >= d->cap) {
+		int cap = d->cap ? d->cap * 2 : 64;
+		DENT *e = malloc((size_t)cap * sizeof(DENT));
+		int *v = malloc((size_t)cap * sizeof(int));
+		if (!e || !v) {
+			free(e);
+			free(v);
+			return 0;
+		}
+		if (d->n)
+			memcpy(e, d->e, (size_t)d->n * sizeof(DENT));
+		free(d->e);
+		free(d->view);
+		d->e = e;
+		d->view = v;
+		d->cap = cap;
+	}
+	x = &d->e[d->n++];
+	memset(x, 0, sizeof(*x));
+	snprintf(x->name, sizeof(x->name), "%s", name);
+	x->size = size;
+	x->date = date;
+	x->time = time;
+	x->dir = dir != 0;
+	return 1;
+}
+
+static int namecmp(const char *a, const char *b)
+{
+	for (; *a && up(*a) == up(*b); a++, b++)
+		;
+	return up(*a) - up(*b);
+}
+
+static const char *ext(const char *n)
+{
+	const char *d = strrchr(n, '.');
+	return d ? d + 1 : "";
+}
+
+static int sort_by;
+static int cmp(const void *pa, const void *pb)
+{
+	const DENT *a = pa, *b = pb;
+	long k = 0;
+	if (a->dir != b->dir)
+		return a->dir ? -1 : 1;	/* folders first */
+	if (!a->dir)
+		switch (sort_by) {
+		case DS_DATE:		/* the newest first, as Selectric */
+			k = ((long)b->date << 16 | b->time) - ((long)a->date << 16 | a->time);
+			break;
+		case DS_SIZE:		/* the biggest first */
+			k = b->size > a->size ? 1 : b->size < a->size ? -1 : 0;
+			break;
+		case DS_TYPE:
+			k = namecmp(ext(a->name), ext(b->name));
+			break;
+		}
+	if (k)
+		return k > 0 ? 1 : -1;
+	return namecmp(a->name, b->name);
+}
+
+void dl_sort(DLIST *d)
+{
+	sort_by = d->sort;
+	if (d->n > 1)
+		qsort(d->e, (size_t)d->n, sizeof(DENT), cmp);
+	dl_filter(d);
+}
+
+int dl_match(const char *m, const char *s)
+{
+	/* (8.3 names: a backtracking match is enough) */
+	if (!*m)
+		return !*s;
+	if (*m == '*') {
+		for (;; s++) {
+			if (dl_match(m + 1, s))
+				return 1;
+			if (!*s)
+				return 0;
+		}
+	}
+	if (!*s)
+		return 0;
+	if (*m != '?' && up(*m) != up(*s))
+		return 0;
+	return dl_match(m + 1, s + 1);
+}
+
+/* name's extension one of exts' (a space between each) */
+static int ext_in(const char *name, const char *exts)
+{
+	const char *e = ext(name);
+	while (*exts) {
+		size_t n;
+		while (*exts == ' ')
+			exts++;
+		for (n = 0; exts[n] && exts[n] != ' '; n++)
+			;
+		if (n) {
+			size_t k;
+			for (k = 0; k < n && e[k] && up(e[k]) == up(exts[k]); k++)
+				;
+			if (k == n && !e[k])
+				return 1;
+		}
+		exts += n;
+	}
+	return 0;
+}
+
+int dl_type_ok(const DLIST *d, int type, const char *name)
+{
+	const char *x;
+	if (type < 0 || type >= d->ntypes)
+		return 1;
+	x = d->types[type].exts;
+	return !x || !*x || ext_in(name, x);
+}
+
+const char *dl_type_name(const DLIST *d, int type)
+{
+	return type >= 0 && type < d->ntypes ? d->types[type].name : "?";
+}
+
+const char *dl_sort_name(int sort)
+{
+	static const char *const n[DS_N] = { "By name", "By date", "By size", "By type" };
+	return sort >= 0 && sort < DS_N ? n[sort] : "?";
+}
+
+void dl_filter(DLIST *d)
+{
+	int i;
+	int any = !d->mask[0] || !strcmp(d->mask, "*") || !strcmp(d->mask, "*.*");
+	d->nview = 0;
+	for (i = 0; i < d->n; i++) {
+		DENT *e = &d->e[i];
+		if (e->dir || (dl_type_ok(d, d->type, e->name) && (any || dl_match(d->mask, e->name))))
+			d->view[d->nview++] = i;
+		else
+			e->sel = 0;	/* (out of sight: not added) */
+	}
+}
+
+DENT *dl_at(DLIST *d, int row)
+{
+	return row >= 0 && row < d->nview ? &d->e[d->view[row]] : 0;
+}
+
+void dl_select_all(DLIST *d, int on)
+{
+	int r;
+	for (r = 0; r < d->nview; r++) {
+		DENT *e = dl_at(d, r);
+		e->sel = on && !e->dir;
+	}
+}
+
+void dl_select_only(DLIST *d, int row)
+{
+	DENT *e = dl_at(d, row);
+	dl_select_all(d, 0);
+	if (e)
+		e->sel = 1;
+}
+
+void dl_toggle(DLIST *d, int row)
+{
+	DENT *e = dl_at(d, row);
+	if (e)
+		e->sel = !e->sel;
+}
+
+void dl_select_range(DLIST *d, int a, int b)
+{
+	int r;
+	if (a > b) {
+		r = a;
+		a = b;
+		b = r;
+	}
+	dl_select_all(d, 0);
+	for (r = a; r <= b; r++) {
+		DENT *e = dl_at(d, r);
+		if (e)
+			e->sel = 1;
+	}
+}
+
+int dl_selected_dirs(const DLIST *d)
+{
+	int r, k = 0;
+	for (r = 0; r < d->nview; r++)
+		k += d->e[d->view[r]].sel && d->e[d->view[r]].dir;
+	return k;
+}
+
+int dl_selected(const DLIST *d, long *bytes)
+{
+	int r, k = 0;
+	long b = 0;
+	for (r = 0; r < d->nview; r++) {
+		const DENT *e = &d->e[d->view[r]];
+		if (e->sel) {
+			k++;
+			if (!e->dir)
+				b += e->size;
+		}
+	}
+	if (bytes)
+		*bytes = b;
+	return k;
+}
+
+void dl_size_text(long size, char *out)
+{
+	if (size < 1024)
+		sprintf(out, "%ld", size);
+	else if (size < 1024L * 1024)
+		sprintf(out, "%ldK", (size + 512) / 1024);
+	else if (size < 10L * 1024 * 1024) {
+		long t = (size * 10 + 512L * 1024) / (1024L * 1024);	/* tenths of a MB */
+		sprintf(out, "%ld.%ldM", t / 10, t % 10);
+	} else
+		sprintf(out, "%ldM", (size + 512L * 1024) / (1024L * 1024));
+}
+
+void dl_date_text(unsigned short date, char *out)
+{
+	sprintf(out, "%02u.%02u.%02u", date & 31, (date >> 5) & 15, (unsigned)((date >> 9) + 80) % 100);
+}
diff --git a/common/src/dirlist.h b/common/src/dirlist.h
new file mode 100644
index 0000000..a773420
--- /dev/null
+++ b/common/src/dirlist.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (C) 2026 AERA | Erez Yaary */
+/*
+ * dirlist.h - a folder's entries for the family's file dialog (ui/filepick.c;
+ * from EPlay's Add files, Erez, 4 Nov 2026: Selectric's ways, a selection,
+ * no check boxes): its folders and files with their sizes and dates, as
+ * many as memory holds, sorted (folders first) by name, date, size or
+ * type, and the view of them a type and a mask (* and ?) let through, each
+ * file selected or not. The types are the app's: a table of names and the
+ * extensions each lets through. No TOS here: the dialog reads the folder
+ * and hands each entry in, so the host can test it all (tests/dirlist).
+ */
+#ifndef AERA_DIRLIST_H
+#define AERA_DIRLIST_H
+
+typedef struct {
+	char name[14];		/* 8.3, as GEMDOS gives it */
+	long size;
+	unsigned short date;	/* GEMDOS's: year - 1980 << 9 | month << 5 | day */
+	unsigned short time;
+	unsigned char dir;	/* a folder */
+	unsigned char sel;	/* selected (files only) */
+} DENT;
+
+/* the Type pop-up's entries, the app's: its name ("Music files") and the
+   extensions it lets through, a space between ("MP3 WAV AIF AIFF"), ""
+   for every file. The first is the dialog's own at its start */
+typedef struct {
+	const char *name;
+	const char *exts;
+} DL_TYPE;
+#define DL_TYPES 12		/* the most a pop-up holds */
+
+enum { DS_NAME, DS_DATE, DS_SIZE, DS_TYPE, DS_N };		/* the Sort pop-up */
+
+typedef struct {
+	DENT *e;
+	int n, cap;		/* all the folder's entries, sorted */
+	int *view, nview;	/* those shown: indexes into e */
+	int type, sort;		/* type: an index into types */
+	char mask[14];		/* "" or "*": everything */
+	const DL_TYPE *types;	/* dl_init: one, "All files" */
+	int ntypes;
+} DLIST;
+
+void dl_init(DLIST *d);
+void dl_types(DLIST *d, const DL_TYPE *t, int n);	/* the app's; type 0 then */
+void dl_free(DLIST *d);
+void dl_clear(DLIST *d);	/* its entries gone (another folder), the type, sort and mask kept */
+/* an entry of the folder read ("." and ".." are left out): 0 when there's
+   no memory for it */
+int dl_add(DLIST *d, const char *name, long size, unsigned short date, unsigned short time, int dir);
+/* sorted (folders first, then the files, each as d->sort has it), and
+   the view made again from the type and the mask (folders always) */
+void dl_sort(DLIST *d);
+void dl_filter(DLIST *d);
+DENT *dl_at(DLIST *d, int row);		/* the view's row: 0 past it */
+
+int dl_match(const char *mask, const char *name);	/* * and ?, case aside */
+int dl_type_ok(const DLIST *d, int type, const char *name);
+const char *dl_type_name(const DLIST *d, int type);	/* its name: "?" past the table */
+const char *dl_sort_name(int sort);	/* "By name", ... */
+
+/* the selection: in the view's rows */
+void dl_select_only(DLIST *d, int row);
+void dl_toggle(DLIST *d, int row);
+void dl_select_range(DLIST *d, int a, int b);	/* a to b, and only them */
+void dl_select_all(DLIST *d, int on);	/* on: every file (not the folders: a drive's all at once) */
+int dl_selected_dirs(const DLIST *d);	/* of those, the folders (added with their subfolders) */
+int dl_selected(const DLIST *d, long *bytes);	/* how many rows (files and folders), the files' bytes */
+
+/* "7.1M", "64M", "512K", "12"; "03.11.26" */
+void dl_size_text(long size, char *out);
+void dl_date_text(unsigned short date, char *out);
+
+#endif
diff --git a/common/tests/dirlist/Makefile b/common/tests/dirlist/Makefile
