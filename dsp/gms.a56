; SPDX-License-Identifier: GPL-2.0-or-later
; Copyright (C) 2026 AERA | Erez Yaary
;
; gms.a56 - the internal synth on the Falcon's DSP (DESIGN.md, "The synth
; on the DSP: through the DMA"): a block of src/gmsdsp.h's (its voices'
; headers and 8-bit points, the 68030's) rendered into GMSD_N synth samples,
; left and right, as src/gmsdsp.c's gmsd_dsp computes them, bit for bit.
; Small enough for the bootstrap's 512 words.
;
; PLAY streams: the sound DMA plays two stereo tracks (4 words a frame)
; into the SSI's receive, a fast interrupt putting each word in RXB's
; ring (4 blocks); the DSP finds each block by its first word (GMSD_MAGIC, however
; many words on the DMA started), renders it, makes its 64 samples the
; output's 128 frames (each pair's mean, then the pair; doubled,
; saturated: gmsd_up) and puts them in slots 0 and 1 of TXB's ring, 4
; segments of 128 frames (4 words each), which a fast interrupt sends to the matrix a
; word a slot (the DAC takes the first track). A segment once played is
; cleared, so that silence follows where no block came (the 68030 stopped
; writing): never the ring's old sound again.
;
; The host's commands (each word waited for):
;	1 LOADX addr n w...	n words to X:addr
;	4 LOADY addr n w...	n words to Y:addr
;	6 LOADP addr n w...	n words to P:addr (the stream's part, from P:$7000)
;	7 RENDER addr		the block at X:addr (16-bit words, each in its top
;				16 bits, as the SSI takes the DMA's): 1, the
;				render, 2, then the 2 x 64 samples (left, right)
;	8 PLAY			the stream, until the host's next word (any: STOP),
;				the late count as it goes, $800000 + n, each time the
;				host has read the last (the synth judged by it as
;				it plays: DESIGN.md), then its counts: the blocks
;				rendered, those late
;				(their segment already playing), the words passed
;				over finding a block, the receive's place in RXB

HCR	equ	$ffe8
HSR	equ	$ffe9
HRX	equ	$ffeb
PCC	equ	$ffe1
CRA	equ	$ffec
CRB	equ	$ffed
SSISR	equ	$ffee
RX	equ	$ffef
TX	equ	$ffef
IPR	equ	$ffff

MAGIC	equ	$a55a00		; a block's first word (GMSD_MAGIC, in the top 16 bits)
BW	equ	512		; a block's words (GMSD_WORDS: 128 frames of 4)
RXB	equ	$2000		; X: the receive's ring, 4 blocks (modulo 2048: r6)
TXB	equ	$2000		; Y: the transmit's ring, 4 segments of 128 frames (modulo 2048: r7)

N	equ	64		; synth samples a block (GMSD_N)
NV	equ	32		; voices (GMSD_VOICES)

; ---- internal Y
PB	equ	$00		; a voice's points, unpacked (Q23, halved), 128
RB	equ	$80		; the block's right, N
; ---- internal X (the render's loops: no external memory's wait)
LB	equ	$00		; the block's left, N
XS	equ	$40		; a voice's samples, interpolated, N
PD	equ	$80		; each point's difference from the next, 128
; ---- external X
GL	equ	$1380		; each voice's gains now (Q23)
GR	equ	$13a0
SEEN	equ	$13c0		; in the last block
NOW	equ	$13e0		; in this one

; ---- external X (the voice's own, read a few times a voice)
V_NV	equ	$1400		; the block's voices still to do
V_ID	equ	$1401
V_NP	equ	$1402		; its points
V_NW	equ	$1403		; their words
V_PH1	equ	$1404		; its place: the point
V_PH0	equ	$1405		; and the fraction (Q24)
V_GLC	equ	$1406		; its gains now, the sample's
V_GRC	equ	$1407
V_SL	equ	$1408		; and their steps a sample
V_SR	equ	$1409
V_TL	equ	$140a		; at the block's end
V_TR	equ	$140b
V_INCF	equ	$140c		; its step's fraction (Q24)
V_RR	equ	$1410		; PLAY: the next block's place in RXB
V_T	equ	$1411		; the segment it goes to (-1: none yet)
V_SEG	equ	$1412		; the segment playing when last looked at
V_NB	equ	$1413		; the blocks rendered
V_LATE	equ	$1414		; those whose segment was already playing
V_SKIP	equ	$1415		; the words passed over finding a block
V_PL	equ	$1416		; the last block's last sample, left
V_PR	equ	$1417		; and right
V_JUNK	equ	$1418
V_DBG	equ	$1420		; the first block's first 12 words (STOP sends them: the log's)
V_DBGN	equ	$142c		; (kept: 1)
V_ROE	equ	$142d		; the receive's overruns (a word lost)
V_TUE	equ	$142e		; the transmit's underruns
V_SV	equ	$142f		; (r1, kept by the two)

	org	p:$0
	jmp	start

; the SSI's receive, a fast interrupt: each word into RXB's ring (r6, m6
; 2047: the stream's alone); with an overrun, the status read first
	org	p:$0c
	movep	x:RX,x:(r6)+
	nop
	org	p:$0e
	jsr	rxe
; the SSI's transmit, a fast interrupt: TXB's ring a word a slot (r7, m7
; 2047); with an underrun, the status read first
	org	p:$10
	movep	y:(r7)+,x:TX
	nop
	org	p:$12
	jsr	tue

	org	p:$40
start	movep	#1,x:$ffe0		; port B is the host port
	movep	#0,x:$fffe		; no wait states
	ori	#3,mr			; no interrupts
	movec	#$ffff,m0
	movec	#$ffff,m1
	movec	#$ffff,m3
	movec	#$ffff,m4
	movec	#$ffff,m5
	movec	#$ffff,m6
	clr	a
	move	#GL,r1			; the gains and the voices seen: none
	rep	#4*NV
	move	a,x:(r1)+
cmd	jsr	rd
	move	x0,a
	move	#>1,x1
	cmp	x1,a
	jeq	ldx
	move	#>4,x1
	cmp	x1,a
	jeq	ldy
	move	#>6,x1
	cmp	x1,a
	jeq	ldp
	move	#>7,x1
	cmp	x1,a
	jeq	rendc
	move	#>8,x1
	cmp	x1,a
	jeq	play
	jmp	cmd

rxe	movep	x:SSISR,x:V_JUNK
	movep	x:RX,x:(r6)+
	move	r1,x:V_SV		; (counted: r1 linear, m1 $ffff)
	move	x:V_ROE,r1
	nop
	lua	(r1)+,r1
	move	r1,x:V_ROE
	move	x:V_SV,r1
	rti
tue	movep	x:SSISR,x:V_JUNK
	movep	y:(r7)+,x:TX
	move	r1,x:V_SV
	move	x:V_TUE,r1
	nop
	lua	(r1)+,r1
	move	r1,x:V_TUE
	move	x:V_SV,r1
	rti

rd	jclr	#0,x:HSR,rd
	movep	x:HRX,x0
	rts
wr	jclr	#1,x:HSR,wr
	movep	x1,x:HRX
	rts

ldx	jsr	rd
	move	x0,r0
	jsr	rd
	do	x0,ldx1
	jsr	rd
	move	x0,x:(r0)+
ldx1
	jmp	cmd
ldp	jsr	rd
	move	x0,r0
	jsr	rd
	do	x0,ldp1
	jsr	rd
	movem	x0,p:(r0)+
ldp1
	jmp	cmd
ldy	jsr	rd
	move	x0,r0
	jsr	rd
	do	x0,ldy1
	jsr	rd
	move	x0,y:(r0)+
ldy1
	jmp	cmd

rendc	jsr	rd
	move	x0,r0
	movec	#2047,m0		; (as the stream's ring: an address in RXB)
	move	#>1,x1
	jsr	wr
	jsr	render
	movec	#$ffff,m0
	move	#>2,x1
	jsr	wr
	move	#LB,r1
	move	#RB,r3
	do	#N,rnd1
	move	x:(r1)+,x1
	jsr	wr
	move	y:(r3)+,x1
	jsr	wr
rnd1
	jmp	cmd

; a 16-bit word (X:(r0)+, in its top 16 bits) as an integer into a1
w16	move	x:(r0)+,a
	rep	#8
	asr	a
	rts

; ---- the block at X:r0 (m0 as its ring) into LB and RB
; (do loops, not rep: a rep holds interrupts off, and the stream's receive
; takes a word each 81 cycles; a 64-word rep lost words)
render	clr	a
	move	#LB,r1
	move	#RB,r2
	do	#N,rc1
	move	a,x:(r1)+
	move	a,y:(r2)+
rc1
	move	#NOW,r1
	do	#NV,rc2
	move	a,x:(r1)+
rc2
	jsr	w16			; its first word: GMSD_MAGIC (the stream found it)
	jsr	w16			; the voices (more than NV: none, as the model)
	move	#>NV,x1
	cmp	x1,a
	jle	rn0
	clr	a
rn0	move	a1,x:V_NV
	tst	a
	jeq	rnfin
vlp	jsr	w16			; its number
	move	#>NV-1,x1
	and	x1,a
	move	a1,x:V_ID
	move	x:(r0)+,x0		; its place's fraction: Q16 << 8, Q24
	move	x0,x:V_PH0
	clr	a
	move	a,x:V_PH1
	jsr	w16			; its step's whole part
	move	a1,y1
	move	x:(r0)+,x0		; and its fraction (Q24)
	move	x0,x:V_INCF
	move	x:(r0)+,x0		; the gains at the block's end: Q15 << 8, Q23
	move	x0,x:V_TL
	move	x:(r0)+,x0
	move	x0,x:V_TR
	jsr	w16			; the points: 2 to 128 (a damaged block's held there, as the model)
	move	#>128,x1
	cmp	x1,a
	jle	rn1
	move	x1,a
rn1	move	#>2,x1
	cmp	x1,a
	jge	rn2
	move	x1,a
rn2	move	a1,x:V_NP
	move	#>1,x0
	add	x0,a
	asr	a			; their words
	move	a1,x:V_NW
	; the points unpacked: each word's high byte, then its low, Q23 halved
	move	#PB,r4
	move	#>$ff0000,x1
	move	#>$000080,y0		; (y0 the step's again after)
	move	x:V_PH0,x0		; (the fraction kept too)
	move	x0,x:V_SR
	move	x:V_NW,x0
	do	x0,unp
	move	x:(r0)+,x0
	move	x0,a
	and	x1,a			; the high byte, in A1's top (A2 its sign)
	asr	a
	move	a1,y:(r4)+
	mpy	x0,y0,a			; the word x 2^8: the low byte in A0's top
	move	a0,x0
	move	x0,a			; (its sign extended)
	asr	a
	move	a1,y:(r4)+
unp
	; each point's difference from the next (the last's: 0)
	move	#PB,r4
	move	#PD,r1
	move	x:V_NP,a
	move	#>1,x0
	sub	x0,a
	move	a1,x:V_NW
	move	x:V_NW,x0
	do	x0,dif
	move	y:(r4)+,x0
	move	y:(r4),a
	sub	x0,a
	move	a,x:(r1)+
dif
	clr	a
	move	a,x:(r1)
	move	x:V_INCF,y0		; (the step's fraction: y0 was the unpacking's)
	; the gains: where the last block left the voice (0 if it wasn't in it)
	move	x:V_ID,n2
	move	#SEEN,r2
	clr	a
	move	a,x:V_GLC
	move	a,x:V_GRC
	move	x:(r2+n2),b
	tst	b
	jeq	gn1
	move	#GL,r2
	nop
	move	x:(r2+n2),x0
	move	x0,x:V_GLC
	move	#GR,r2
	nop
	move	x:(r2+n2),x0
	move	x0,x:V_GRC
gn1	move	x:V_TL,b		; the steps: (end - now) / 64, floor
	move	x:V_GLC,x0
	sub	x0,b
	rep	#2
	asr	b
	move	b1,x:V_SL
	move	x:V_TR,b
	move	x:V_GRC,x0
	sub	x0,b
	rep	#2
	asr	b
	move	b1,x:V_SR
	; the samples: first each interpolated, into XS (a the place, y its step)
	move	#PB,r4
	move	#PD,r1
	move	#XS,r2
	move	x:V_PH1,a
	move	x:V_PH0,a0
	do	#N,slp
	move	a1,n4			; the point
	move	a1,n1
	move	a0,b
	lsr	b			; the fraction, Q23
	move	b1,x1
	move	y:(r4+n4),b		; s0
	move	x:(r1+n1),x0		; s1 - s0
	mac	x0,x1,b			; s0 + (s1 - s0) f
	add	y,a	b,x:(r2)+	; the next place
slp
	; then mixed, left and right together, a gain held GMSD_CHUNK samples
	move	#XS,r2
	move	#LB,r1
	move	#RB,r5
	do	#N/16,mxc
	move	x:V_GLC,x1
	move	x:V_GRC,y1
	do	#16,mx
	move	x:(r2)+,x0
	move	x:(r1),a	y:(r5),b
	mac	x0,x1,a
	mac	x0,y1,b
	move	a,x:(r1)+	b,y:(r5)+
mx
	move	x:V_GLC,a		; the gains a step on
	move	x:V_SL,x0
	add	x0,a
	move	a1,x:V_GLC
	move	x:V_GRC,a
	move	x:V_SR,x0
	add	x0,a
	move	a1,x:V_GRC
mxc
	; the gains as the block leaves them: its ends
	move	x:V_ID,n2
	move	#GL,r2
	move	x:V_TL,x0
	move	x0,x:(r2+n2)
	move	#GR,r2
	move	x:V_TR,x0
	move	x0,x:(r2+n2)
	move	#NOW,r2
	move	#>1,x0
	move	x0,x:(r2+n2)
	move	x:V_NV,a
	move	#>1,x0
	sub	x0,a
	move	a1,x:V_NV
	jne	vlp
rnfin	; the voices not in this block: their gains 0
	move	#NOW,r1
	move	#SEEN,r2
	move	#GL,r3
	move	#GR,r4
	clr	b
	do	#NV,rf1
	move	x:(r1)+,a
	move	a,x:(r2)+
	tst	a
	jne	rf2
	move	b,x:(r3)
	move	b,x:(r4)
rf2	move	(r3)+
	move	(r4)+
	nop
rf1
	rts

; ---- what the stream needs alone: in external P (P:$7000 is X:$3000,
; which nothing else here uses), loaded with LOADP after the bootstrap
	org	p:$7000

; ---- PLAY: the stream (the header's), until the host's next word
play	clr	a
	move	#GL,r1			; the voices' gains and those seen: none (a new piece)
	rep	#4*NV
	move	a,x:(r1)+
	move	#TXB,r1			; the output's ring silent
	do	#2048,pl1
	move	a,y:(r1)+
pl1
	move	#RXB,r1			; and the input's
	do	#2048,pl2
	move	a,x:(r1)+
pl2
	move	a,x:V_NB
	move	a,x:V_LATE
	move	a,x:V_SKIP
	move	a,x:V_PL
	move	a,x:V_PR
	move	a,x:V_SEG
	move	a,x:V_DBGN
	move	a,x:V_ROE
	move	a,x:V_TUE
	move	#>-1,x0
	move	x0,x:V_T
	move	#RXB,r6
	movec	#2047,m6
	move	r6,x:V_RR
	move	#TXB+1,r7		; (slot 0's word goes out as the first interrupt comes)
	movec	#2047,m7
	movec	#2047,m0
	movep	#$1f8,x:PCC		; port C: the SSI
	movep	#$4300,x:CRA		; 16 bits, 4 words a frame
	movep	#$f800,x:CRB		; receive, transmit, their interrupts; network mode
	movep	#$3400,x:IPR		; the SSI at level 2
	movep	#0,x:TX
pl3	jclr	#6,x:SSISR,pl3		; slot 0 going: the ring's next word is slot 1's
	jclr	#2,x:SSISR,pl3
	movep	y:(r7)+,x:TX
	andi	#$fc,mr			; interrupts on
; the loop: the segment that played cleared, the next block found and
; rendered, the host's word (STOP) looked for
loop	jsr	seg
	jset	#0,x:HSR,pstop
	jclr	#1,x:HSR,lp0		; the host took the last: the late count now,
	move	x:V_LATE,a		; marked (bit 23) as no count of STOP's is
	move	#>$800000,x0
	or	x0,a
	movep	a1,x:HRX
lp0	move	x:V_RR,r0
	move	r6,a			; the words in: (r6 - rr) modulo 2048
	move	r0,x0
	sub	x0,a
	move	#>2047,x0
	and	x0,a
	move	a1,a
	move	#>2,x0
	cmp	x0,a
	jlt	loop
	move	x:(r0),b		; a block's start?
	move	#>MAGIC,x0
	cmp	x0,b
	jeq	pl4
	; no: the words in looked at in a tight loop (some 16 cycles a word:
	; a word comes each 81, and the loop's way, a word a pass, fell a
	; ring behind through a long silence)
	move	#>1,y1
	sub	y1,a			; (the first is looked at)
pl5	move	(r0)+
	move	x:(r0),b
	cmp	x0,b
	jeq	pl6
	sub	y1,a
	jgt	pl5
pl6	move	x:V_RR,x1		; the words passed over: (r0 - rr) modulo 2048
	move	r0,b
	sub	x1,b
	move	#>2047,x1
	and	x1,b
	move	b1,b
	move	x:V_SKIP,x1
	add	x1,b
	move	b1,x:V_SKIP
	move	r0,x:V_RR
	jmp	loop
pl4	move	#>BW,x0			; the whole block in?
	cmp	x0,a
	jlt	loop
	move	x:V_DBGN,b		; (the first block's first words kept, for the log)
	tst	b
	jne	pl7
	move	#V_DBG,r1
	do	#12,pl8
	move	x:(r0)+,x0
	move	x0,x:(r1)+
pl8
	move	#>1,x0
	move	x0,x:V_DBGN
	move	x:V_RR,r0
pl7	jsr	render
	move	x:V_RR,r0		; the next block's place
	move	#>BW,n0
	nop
	move	(r0)+n0
	move	r0,x:V_RR
	jsr	seg
	jsr	out
	move	x:V_NB,b
	move	#>1,x0
	add	x0,b
	move	b1,x:V_NB
	jmp	loop

; the segment playing (r7's) into a; once it has moved on, the one it
; left cleared (slots 2 and 3 too: the next block's writes 0 and 1)
seg	move	r7,a
	move	#>TXB,x0
	sub	x0,a
	rep	#9
	asr	a
	move	#>3,x0
	and	x0,a
	move	a1,a
	move	x:V_SEG,b
	cmp	a,b
	jeq	sg9
	move	a1,x:V_SEG
	rep	#9			; the one left (b's): cleared
	asl	b
	move	#>TXB,x0
	add	x0,b
	move	b1,r1
	clr	b
	do	#BW,sg1
	move	b,y:(r1)+
sg1
sg9	rts

; the block's samples (LB, RB) as the output's 128 frames into segment
; V_T, then V_T on; the first block, or one whose segment is already
; playing (late), two segments ahead of the one playing
out	move	x:V_SEG,a
	move	x:V_T,b
	tst	b
	jlt	ot1
	cmp	a,b
	jne	ot2
	move	x:V_LATE,b
	move	#>1,x0
	add	x0,b
	move	b1,x:V_LATE
ot1	move	#>2,x0
	add	x0,a
	move	#>3,x0
	and	x0,a
	move	a1,b
ot2	move	b1,x:V_T
	rep	#9
	asl	b
	move	#>TXB,x0
	add	x0,b
	move	b1,r1			; slot 0 of the segment's first frame
	move	#>3,n1
	move	#LB,r2
	move	#RB,r3
	do	#N,ot3
	; (frame 2j: the mean of the last sample and this, doubled; 2j + 1:
	; this, doubled; each through the limiter: saturated)
	move	x:V_PL,b
	move	x:(r2),x0
	add	x0,b
	asr	b
	move	b1,b
	asl	b
	move	b,y:(r1)+
	move	x:V_PR,b
	move	y:(r3),x0
	add	x0,b
	asr	b
	move	b1,b
	asl	b
	move	b,y:(r1)+n1
	move	x:(r2)+,a
	move	a,x:V_PL
	asl	a
	move	a,y:(r1)+
	move	y:(r3)+,a
	move	a,x:V_PR
	asl	a
	move	a,y:(r1)+n1
ot3
	move	x:V_T,a
	move	#>1,x0
	add	x0,a
	move	#>3,x0
	and	x0,a
	move	a1,x:V_T
	rts

; STOP: the SSI off, the word read, the counts sent
pstop	ori	#3,mr
	movep	#0,x:CRB
	movep	#0,x:IPR
	movep	x:HRX,x0
	movec	#$ffff,m0
	movec	#$ffff,m6
	movec	#$ffff,m7
	move	x:V_NB,x1
	jsr	wr
	move	x:V_LATE,x1
	jsr	wr
	move	x:V_SKIP,x1
	jsr	wr
	move	r6,x1			; (and the receive's place: a word came at all?)
	jsr	wr
	move	x:V_ROE,x1		; the receive's overruns, the transmit's underruns
	jsr	wr
	move	x:V_TUE,x1
	jsr	wr
	move	#V_DBG,r1		; and the first block's first 12 words
	do	#12,ps1
	move	x:(r1)+,x1
	jsr	wr
	nop
ps1
	jmp	cmd
