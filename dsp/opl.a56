; SPDX-License-Identifier: GPL-2.0-or-later
; Copyright (C) 2026 AERA | Erez Yaary
;
; opl.a56 - the YM3812 (OPL2) and the YMF262 (OPL3) for a VGM file on the
; Falcon's DSP (phase 10, step 7), at the Falcon's 24,585 Hz (an OPL3's
; second bank in use: 16,390): src/oplfast.c's arithmetic, word for word
; (tests/dspopl holds it to it, bit for bit). The 68030 does the chip's
; registers (src/opld.c) and sends what changed, as the commands below.
;
; Each sample: the rhythm mode's noise on; each channel's handler (X:VT,
; each jumping to the next's, the last's to the mix,
; set at each update: FM's, both out's, the bass drum's, the drums', or the
; silent one's when both operators are); an operator its phase (2^21 a turn)
; on by its step, its modulation added (the modulator's output as it is),
; the index the phase's bits 20-11 (mpy by $1000, and $3FF), its waveform's
; table (its base in Y, by the operator) times its gain; the channel the sum
; / 8 (the rhythm mode's / 4), limited; the nine (NCH: eighteen) mixed by
; their left and right gains. An OPL3's four-operator pair as its two
; channels in their order, each its own output: its first's handler A and
; B (fmlink, outlink; algorithm 1 FM's), its second's C and D (fmin,
; addin; algorithm 1 FM's), B's output their link (in the second's
; feedback's first word: C has none). Each OPL_UPD (32) samples, the update: the tremolo and the
; vibrato, each operator's envelope (its mode a handler's address), its gain
; from the table, its step with the vibrato's.
;
; The host's words, a command's number then its words:
;	1 LOADX ADDR N w..., 4 LOADY ADDR N w..., 6 LOADP ADDR N w...
;	2 OP i: step tl arf d1 d2 rr sl am vib ws	(src/opld.h's OPLC_*)
;	3 CH c: cnt kf left right dw
;	5 KEY i: 1 on, 2 off
;	7 LFO: the tremolo's step, the vibrato's, the tremolo deep (1)
;	8 RHY: the rhythm mode on (1), the noise's steps a sample
;	9 RUN n: n samples, each its left and right word to the host (tests)
;	10 PLAY k: the SSI on, the samples into its ring; the commands still
;	   taken between samples, and while the host's flag 0 is set (a
;	   burst of them coming) no sample made. k 2: each sample twice, the
;	   first halfway from the one before (the FDI's 44.1 or 48 kHz); k 3:
;	   three times, the first two a third and two thirds of the way (the
;	   FDI's, with the OPL3's second bank)
;	16 STEP i s: operator i's step alone
;	15 STATUS: one word back, the ring's least lead since it first filled
;	17 NCH n: the channels made, 9 or 18
;	12 RESET: all silent
;
; Memory: what runs each sample in internal P; the rest from P:$7000
; (X:$3000), loaded with LOADP.

PBC	equ	$ffe0
PCC	equ	$ffe1
HCR	equ	$ffe8
HSR	equ	$ffe9
HRX	equ	$ffeb
HTX	equ	$ffeb
CRA	equ	$ffec
CRB	equ	$ffed
SSISR	equ	$ffee
TX	equ	$ffef
BCR	equ	$fffe
IPR	equ	$ffff

OPL_UPD	equ	32		; samples between updates (src/opld.h's)
ATTMAX	equ	$3fe000		; 511 envelope steps of 8,192: off
AKOFF	equ	$9000		; (the attack's 4.5 steps: oplfast.c's OPLF_AK)

; ---- internal X (short addresses: $00-$3F)
UPD	equ	$00		; samples to the next update, x $010000 (a short immediate's step)
MASK	equ	$01		; $3FF: the index's
AK	equ	$02		; AKOFF
ATTM	equ	$03		; ATTMAX
AMTV	equ	$04		; (update) the tremolo now
PMWV	equ	$07		; (update) the vibrato's pattern now
AMP	equ	$08		; the tremolo's phase (2^24 its period), its step
AMS	equ	$09
PMP	equ	$0a		; the vibrato's
PMS	equ	$0b
JUNK	equ	$0c
CHSP	equ	$0d		; (update) the channel's block
AMD	equ	$0e		; the tremolo's table (AMT, or AMT+256 deep)
RHY	equ	$0f		; the rhythm mode
NOISE	equ	$22		; the noise's register (23 bits) x 2 (its bit 0 at bit 1), its steps a sample
NSTEPS	equ	$23
HI	equ	$24		; (drums) the hi-hat's index; a temporary
T1	equ	$25
MINLD	equ	$26		; (PLAY) the ring's least lead since it first filled: STATUS's
PFULL	equ	$27		; (PLAY) the ring has filled to LEAD once
PLX	equ	$28		; (PLAY) 2: each sample twice, 3 three times; the one before (L, R)
PREVL	equ	$29
GH	equ	$2a		; (drums) the hi-hat's gain, the snare's, the cymbal's;
GS	equ	$2b		; the hi-hat's waveform, the snare's
GC	equ	$2c
WH	equ	$2d
WS	equ	$2e
NCH	equ	$2f		; bit 0: eighteen channels made, not nine
NUCH	equ	$30		; the channels updated: 9 or 18
LCHG	equ	$31		; bit 1: an operator went off this update; bit 0: the one before
K1000	equ	$32		; $1000 (the index's multiplier: a short read, not a long immediate)
T3L1	equ	$33		; (PLAY 3) the left's first and second of three
T3L2	equ	$34
				; (its channel's live 0 at the next: the handlers chosen again then)
VT	equ	$40		; the handlers, chained: channel k's next's handler at VT + 2k,
				; its output at VT + 2k + 1; the first's at VT - 2 (to $63);
				; the last's next the mix
HND0	equ	VT-2
CHX	equ	$64		; each operator's phase, gain (2 each, 36: to $AB)
FB	equ	$ac		; each channel's feedback's factor, its modulator's last two (3 each, to $E1)
; ---- internal Y
PAN	equ	$00		; each channel's left, right gains (2 each, 18)
PREVR	equ	$24
CHY	equ	CHX		; each operator's step with the vibrato's, its waveform's base (to $AB):
				; at CHX's address (opblk takes one for both)
; ---- external X
GAIN	equ	$0400		; 2^(-A/64), 2,048
OPS	equ	$0c00		; each operator's (16 each): its mode (its handler), the
				; mode's increment (its attack's factor in the attack),
				; sl, att, tl, am, vib, step, arf, d1, d2, rr
CHS	equ	$0e40		; each channel's (8 each): live, cnt, dw (OPS: 36 blocks)
AMT	equ	$1000		; the tremolo, half steps: 256 shallow, 256 deep (modulo 256)
PMWT	equ	$1200		; the vibrato's pattern, 8 (modulo 8)
; ---- external Y
RING	equ	$1800		; the SSI's ring, 2,048 words (modulo 2,048)
LEAD	equ	1536		; the words written ahead of the SSI
WAVE	equ	$2000		; the eight waveforms, 1,024 each

O_MODE	equ	0
O_INC	equ	1
O_SL	equ	2
O_ATT	equ	3
O_TL	equ	4
O_AM	equ	5
O_VIB	equ	6
O_STEP	equ	7
O_ARF	equ	8
O_D1	equ	9
O_D2	equ	10
O_RR	equ	11
C_LIVE	equ	0
C_CNT	equ	1
C_DW	equ	2

	org	p:$0
	jmp	start

; the SSI's transmit, a fast interrupt: the ring to the matrix
	org	p:$10
	movep	y:(r7)+,x:TX
	nop
	org	p:$12			; with an underrun: the status read, then the word
	jsr	tue

	org	p:$14
start	movep	#1,x:PBC		; port B is the host port
	movep	#0,x:BCR		; no wait states
	ori	#3,mr			; no interrupts
	movec	#$ffff,m0
	jmp	cmd

; a host word into x0
rd	jclr	#0,x:HSR,rd
	movep	x:HRX,x0
	rts

; ---- the commands: LOADP here, the rest in the external part
cmd	jsr	rd
	move	x0,a
	move	#>6,x1
	cmp	x1,a
	jne	cmdx
	jsr	rd
	move	x0,r0
	jsr	rd
	do	x0,lp
	jsr	rd
	movem	x0,p:(r0)+
lp
	jmp	cmd

; ---- a sample: A the left, B the right (limited when stored)
sample	move	x:<UPD,a
	move	#1,x1			; ($010000: a sample)
	sub	x1,a
	move	a,x:<UPD
	jne	smp1
	jsr	update
smp1	jclr	#0,x:<RHY,smp2		; the rhythm mode's noise
	jsr	noise
smp2	move	x:<HND0,r2		; the first channel's handler: each jumps to the next's
	move	#CHX,r0
	move	#CHY,r5
	move	#FB,r1
	move	#VT,r3
	move	x:<K1000,x0
	move	#4,n0
	move	#3,n1
	move	#4,n5
	move	#7,n2			; (the link: x:(r2+n2))
	jmp	(r2)

; the mix (the last channel's next): the channels made (NUCH: nine, or
; eighteen), each by its left and right gains; a hardware loop, two words
; a channel (its last's reads past the end, unused)
mix	move	#VT+1,r0		; (each channel's output)
	move	#PAN,r5
	move	#2,n0
	clr	a
	clr	b	x:(r0)+n0,x1	y:(r5)+,y1
	do	x:<NUCH,mx1
	mac	y1,x1,a	y:(r5)+,y1
	mac	y1,x1,b	x:(r0)+n0,x1	y:(r5)+,y1
mx1
	rts

; a silent channel: 0, its operators passed over
sil	move	x:(r3)+,r2		; (the next's handler)
	clr	a
	move	a,x:(r3)+
	move	(r0)+n0
	move	(r5)+n5
	move	(r1)+n1
	jmp	(r2)
nul	equ	sil			; (the rhythm mode's channel 8: the drums' jump past it)

; FM: the modulator (its feedback) > the carrier
fmh	move	x:(r0),b	y:(r5)+,y0	; the modulator: its phase, its step
	add	y0,b	y:(r5)+,r4	; on; its waveform
	move	b1,x:(r0)+		; (kept)
	move	x:(r1)+,y0		; the feedback's factor
	move	x:(r1)+,x1		; its last output
	mac	x1,y0,b	x:(r1)-,x1	; x the factor; the one before
	mac	x1,y0,b	x:(r0)+,y0	; x the factor; its gain
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1	; the index (bits 20-11)
	and	x1,b	x:(r1)+,x1	; (its last output)
	move	b1,n4
	move	x1,x:(r1)-		; (the one before)
	move	y:(r4+n4),y1		; its waveform
	mpy	y1,y0,b			; x its gain
	move	b,x1			; its output (limited)
	move	x1,x:(r1)+		; (kept)
	move	x:(r0),b	y:(r5)+,y0	; the carrier
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	add	x1,b	x:(r0)+,y0	; + the modulator's output; its gain
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b
	move	b1,n4
	move	(r1)+			; (the next channel's)
	move	y:(r4+n4),y1
	mpy	y1,y0,a
chend	move	x:(r3)+,r2		; (the next's handler)
	asr	a			; / 8
	asr	a
	asr	a
	move	a,x:(r3)+		; (limited)
	jmp	(r2)
bdend	move	x:(r3)+,r2
	asr	a			; / 4
	asr	a
	move	a,x:(r3)+
	jmp	(r2)

; both out: the modulator (its feedback) + the carrier
addh	move	x:(r0),b	y:(r5)+,y0
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	x:(r1)+,y0
	move	x:(r1)+,x1
	mac	x1,y0,b	x:(r1)-,x1
	mac	x1,y0,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r1)+,x1
	move	b1,n4
	move	x1,x:(r1)-
	move	y:(r4+n4),y1
	mpy	y1,y0,a			; (a carrier too)
	move	a,x1
	move	x1,x:(r1)+
	move	x:(r0),b	y:(r5)+,y0	; the carrier: no modulation
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r0)+,y0
	move	b1,n4
	move	(r1)+
	move	y:(r4+n4),y1
	mac	y1,y0,a
	jmp	chend

; ---- an OPL3's four-operator pair: its first channel (A, its feedback,
; and B), B's output its link to its second (three on: x:(r2+n2), r2 r1,
; n2 7,
; its feedback's first word); its second (C and D, the link C's
; modulation)
; the first, algorithm 0: A > B, its own output 0
fmlink
	move	x:(r0),b	y:(r5)+,y0	; A: as FM's modulator, its feedback
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	x:(r1)+,y0
	move	x:(r1)+,x1
	mac	x1,y0,b	x:(r1)-,x1
	mac	x1,y0,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r1)+,x1
	move	b1,n4
	move	x1,x:(r1)-
	move	y:(r4+n4),y1
	mpy	y1,y0,b
	move	b,x1			; its output (limited)
	move	x1,x:(r1)+
	move	x:(r0),b	y:(r5)+,y0	; B, modulated
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	add	x1,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b
	move	b1,n4
	move	r1,r2			; (the link's place: x:(r2+n2))
	move	y:(r4+n4),y1
	mpy	y1,y0,b
	move	b,x1
	move	x1,x:(r2+n2)		; the link
	move	x:(r3)+,r2		; (the next's handler)
	clr	a
	move	(r1)+
	move	a,x:(r3)+
	jmp	(r2)

; the first, algorithms 2 and 3: A out, B alone
outlink
	move	x:(r0),b	y:(r5)+,y0	; A: as FM's modulator, its feedback
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	x:(r1)+,y0
	move	x:(r1)+,x1
	mac	x1,y0,b	x:(r1)-,x1
	mac	x1,y0,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r1)+,x1
	move	b1,n4
	move	x1,x:(r1)-
	move	y:(r4+n4),y1
	mpy	y1,y0,b
	move	b,x1			; its output (limited)
	move	x1,x:(r1)+
	tfr	b,a			; (A out)
	move	x:(r0),b	y:(r5)+,y0	; B, alone
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r0)+,y0
	move	b1,n4
	move	r1,r2			; (the link's place: x:(r2+n2))
	move	y:(r4+n4),y1
	mpy	y1,y0,b
	move	b,x1
	move	x1,x:(r2+n2)		; the link
	move	x:(r3)+,r2		; (the next's handler)
	move	(r1)+
	asr	a			; / 8
	asr	a
	asr	a
	move	a,x:(r3)+		; (limited)
	jmp	(r2)

; the second, algorithms 0 and 2: the link > C > D
fmin	move	x:(r0),b	y:(r5)+,y0	; C, the link's
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	x:(r1)+n1,x1		; the link; (r1 the next channel's)
	add	x1,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b
	move	b1,n4
	move	x:(r3)+,r2		; (the next's handler)
	move	y:(r4+n4),y1
	mpy	y1,y0,b
	move	b,x1			; C's output (limited)
	move	x:(r0),b	y:(r5)+,y0	; D, modulated
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	add	x1,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b
	move	b1,n4
	nop
	move	y:(r4+n4),y1
	mpy	y1,y0,a
	asr	a			; / 8
	asr	a
	asr	a
	move	a,x:(r3)+		; (limited)
	jmp	(r2)

; the second, algorithm 3: the link > C, + D alone
addin	move	x:(r0),b	y:(r5)+,y0	; C, the link's
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	x:(r1)+n1,x1
	add	x1,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b
	move	b1,n4
	move	x:(r3)+,r2		; (the next's handler)
	move	y:(r4+n4),y1
	mpy	y1,y0,a			; (C out)
	move	x:(r0),b	y:(r5)+,y0	; D, alone
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r0)+,y0
	move	b1,n4
	nop
	move	y:(r4+n4),y1
	mac	y1,y0,a
	asr	a			; / 8
	asr	a
	asr	a
	move	a,x:(r3)+		; (limited)
	jmp	(r2)

; the bass drum (the rhythm mode's channel 6): FM's, twice as loud
bdfm	move	x:(r0),b	y:(r5)+,y0
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	x:(r1)+,y0
	move	x:(r1)+,x1
	mac	x1,y0,b	x:(r1)-,x1
	mac	x1,y0,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r1)+,x1
	move	b1,n4
	move	x1,x:(r1)-
	move	y:(r4+n4),y1
	mpy	y1,y0,b
	move	b,x1
	move	x1,x:(r1)+
	move	x:(r0),b	y:(r5)+,y0
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	add	x1,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b
	move	b1,n4
	move	(r1)+
	move	y:(r4+n4),y1
	mpy	y1,y0,a
	jmp	bdend

; the bass drum with its connection 1: the carrier alone (the modulator
; still on, its feedback kept)
bdadd	move	x:(r0),b	y:(r5)+,y0
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	x:(r1)+,y0
	move	x:(r1)+,x1
	mac	x1,y0,b	x:(r1)-,x1
	mac	x1,y0,b	x:(r0)+,y0
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r1)+,x1
	move	b1,n4
	move	x1,x:(r1)-
	move	y:(r4+n4),y1
	mpy	y1,y0,b
	move	b,x1
	move	x1,x:(r1)+
	move	x:(r0),b	y:(r5)+,y0
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r0)+,y0
	move	b1,n4
	move	(r1)+
	move	y:(r4+n4),y1
	mpy	y1,y0,a
	jmp	bdend

; the rhythm mode's channels 7 and 8 (8's handler nul): the hi-hat and the
; snare, the tom and the cymbal, each made, off or not (an operator off has
; its gain 0)
drums	move	x:(r0),b	y:(r5)+,y0	; the hi-hat: its phase on, its index
	add	y0,b	y:(r5)+,y1
	move	b1,x:(r0)+
	move	y1,x:<WH		; (its waveform)
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r0)+,y0
	move	b1,x:<HI
	move	y0,x:<GH		; (its gain)
	move	x:(r0),b	y:(r5)+,y0	; the snare: its phase on
	add	y0,b	y:(r5)+,y1
	move	b1,x:(r0)+
	move	y1,x:<WS
	move	x:(r0)+,y0
	move	y0,x:<GS
	move	x:(r0),b	y:(r5)+,y0	; the tom: a carrier alone, into a
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r0)+,y0
	move	b1,n4
	nop
	move	y:(r4+n4),y1
	mpy	y1,y0,a
	move	x:(r0),b	y:(r5)+,y0	; the cymbal: its phase on, its index
	add	y0,b	y:(r5)+,r4
	move	b1,x:(r0)+
	move	b1,y1
	mpy	x0,y1,b	x:<MASK,x1
	and	x1,b	x:(r0)+,y0
	move	y0,x:<GC
	; ((h2 ^ h7) | (h3 ^ y5) | (y3 ^ y5)), at bit 2 of b1 (h the hi-hat's
	; index, y the cymbal's)
	move	b1,x1			; y
	move	#$20,y1			; ($200000: x 2^-2)
	mpy	y1,x1,b			; y >> 2
	move	b1,y1
	eor	x1,b			; bit 3: y3 ^ y5
	move	b1,x1
	tfr	y1,b			; y >> 2
	move	x:<HI,y1
	eor	y1,b			; bit 3: h3 ^ y5
	or	x1,b
	lsr	b			; (at bit 2)
	move	b1,x:<T1
	move	#$04,x1			; ($040000: x 2^-5)
	mpy	y1,x1,b			; h >> 5
	eor	y1,b			; bit 2: h2 ^ h7
	move	x:<T1,x1
	or	x1,b			; bit 2: the three's or
	; the cymbal at its << 9 | $80; the hi-hat's at its << 9 | ($D0 when
	; it differs from the noise, else $34)
	move	x:<NOISE,x1
	jclr	#2,b1,dx0
	move	#>$280,n4
	move	#>$2d0,y1
	jclr	#1,x1,dx1
	move	#>$234,y1
	jmp	dx1
dx0	move	#>$080,n4
	move	#>$034,y1
	jclr	#1,x1,dx1
	move	#>$0d0,y1
dx1	move	x:<GC,y0
	move	y:(r4+n4),x1		; the cymbal
	mac	x1,y0,a			; + the tom
	asr	a
	asr	a
	move	a,x:VT+17		; channel 8 (limited)
	move	x:<WH,r4		; the hi-hat
	move	y1,n4
	move	x:<GH,y0
	move	y:(r4+n4),x1
	mpy	x1,y0,a
	; the snare at h8 << 9 | (h8 ^ n) << 8
	jclr	#8,x:<HI,ds0
	move	#>$300,n4
	jclr	#1,x:<NOISE,ds1
	move	#>$200,n4
	jmp	ds1
ds0	move	#0,n4
	jclr	#1,x:<NOISE,ds1
	move	#>$100,n4
ds1	move	x:<WS,r4
	move	x:<GS,y0
	nop
	move	y:(r4+n4),x1
	mac	x1,y0,a
	asr	a
	asr	a
	move	(r3)+			; (8's handler: not taken)
	move	a,x:(r3)+		; channel 7
	move	x:(r3)+,r2		; 9's (or the mix)
	move	(r3)+			; (8's output: made above)
	move	(r1)+n1
	move	(r1)+n1
	jmp	(r2)

; the noise: NSTEPS steps of its 23-bit register (in at bit 22: bit 0 ^
; bit 14)
noise	move	x:<NOISE,a		; (n x 2: n0 at bit 1, n22 at bit 23)
	move	#>$200,y1		; (x 2^-14)
	do	x:<NSTEPS,nzl
	move	a1,x1
	mpy	y1,x1,b			; n >> 14
	eor	x1,b			; bit 1: n0 ^ n14
	lsr	b
	lsr	b			; (into the carry)
	ror	a			; n >> 1, the carry in at bit 22 (23)
nzl
	move	a1,x:<NOISE
	rts

; ===================================================================
; external P: the commands, the update, the start of a play
	org	p:$7000

; the SSI's underrun: its status read, then the word
tue	movep	x:SSISR,x:JUNK
	movep	y:(r7)+,x:TX
	rti

cmdx	move	#>1,x1
	cmp	x1,a
	jeq	loadx
	move	#>4,x1
	cmp	x1,a
	jeq	loady
	move	#>9,x1
	cmp	x1,a
	jeq	c_run
	move	#>10,x1
	cmp	x1,a
	jeq	c_play
	move	#>12,x1
	cmp	x1,a
	jeq	c_reset
	jsr	hcmd
	jmp	cmd

loadx	jsr	rd
	move	x0,r0
	jsr	rd
	do	x0,lx
	jsr	rd
	move	x0,x:(r0)+
lx
	jmp	cmd
loady	jsr	rd
	move	x0,r0
	jsr	rd
	do	x0,ly
	jsr	rd
	move	x0,y:(r0)+
ly
	jmp	cmd

; a command (x0 its number), from cmd or play's loop: not a load, not RUN
hcmd	move	x0,a
	move	#>2,x1
	cmp	x1,a
	jeq	hc_op
	move	#>3,x1
	cmp	x1,a
	jeq	hc_ch
	move	#>5,x1
	cmp	x1,a
	jeq	hc_key
	move	#>7,x1
	cmp	x1,a
	jeq	hc_lfo
	move	#>8,x1
	cmp	x1,a
	jeq	hc_rhy
	move	#>16,x1
	cmp	x1,a
	jeq	hc_step
	move	#>15,x1
	cmp	x1,a
	jeq	hc_stat
	move	#>17,x1
	cmp	x1,a
	jeq	hc_nch
	rts

; NCH n: eighteen channels made (n past 9), or nine
hc_nch	jsr	rd
	bclr	#0,x:<NCH
	move	#>9,x1
	move	x1,x:<NUCH
	move	x0,a
	cmp	x1,a
	jle	sethall
	bset	#0,x:<NCH
	move	#>18,x1
	move	x1,x:<NUCH
	jmp	sethall

; STATUS: the ring's least lead, to the host
hc_stat	move	x:<MINLD,x1
hcs1	jclr	#1,x:HSR,hcs1
	movep	x1,x:HTX
	rts

; the operator's number i: r0 its block (OPS + 16 i), r1 its CHX/CHY pair
; (CHX + 2 i), x:JUNK i
opblk	jsr	rd
	move	x0,x:JUNK
	move	x0,x1
	move	#>16,y1
	mpy	x1,y1,a			; (i x 16, x 2: the product's low word)
	asr	a
	move	a0,a
	move	#>OPS,x1
	add	x1,a
	move	a,r0
	move	x:JUNK,a
	asl	a
	move	#>CHX,x1
	add	x1,a
	move	a,r1
	rts

; STEP i s: operator i's step alone, its step with the vibrato's too
hc_step	jsr	opblk
	move	#O_STEP,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	x0,y:(r1)
	rts

; OP i: step, tl, arf, d1, d2, rr, sl, am, vib, ws; its step with the
; vibrato's the step, its waveform's base; the increment of its mode again
hc_op	jsr	opblk
	move	#O_STEP,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	x0,y:(r1)+
	move	#O_TL,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	#O_ARF,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	#O_D1,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	#O_D2,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	#O_RR,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	#O_SL,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	#O_AM,n0
	jsr	rd
	move	x0,x:(r0+n0)
	move	#O_VIB,n0
	jsr	rd
	move	x0,x:(r0+n0)
	jsr	rd			; ws: WAVE + 1,024 ws
	move	#>7,x1
	move	x0,a
	and	x1,a
	move	a1,x1
	move	#>1024,y1
	mpy	x1,y1,a
	asr	a
	move	a0,a
	move	#>WAVE,x1
	add	x1,a
	move	a1,y:(r1)
	move	x:(r0),r3
	jmp	setinc

; the increment of the mode r3 (the operator's block r0) into its block,
; with the mode
setinc	move	#>e_att,a
	move	#O_ARF,n0
	move	r3,x1
	cmp	x1,a
	jeq	si1
	move	#>e_dec,a
	move	#O_D1,n0
	cmp	x1,a
	jeq	si1
	move	#>e_sus,a
	move	#O_D2,n0
	cmp	x1,a
	jeq	si1
	move	#O_RR,n0		; (the release's; off: its, unused)
si1	move	r3,x:(r0)
	move	x:(r0+n0),x1
	move	#O_INC,n0
	nop
	move	x1,x:(r0+n0)
	rts

; CH c: cnt, kf, left, right, dw
hc_ch	jsr	rd
	move	x0,x:JUNK
	move	x0,x1
	move	#>8,y1			; its block
	mpy	x1,y1,a
	asr	a
	move	a0,a
	move	#>CHS,x1
	add	x1,a
	move	a,r1
	move	x:JUNK,a		; its PAN pair
	asl	a
	move	#>PAN,x1
	add	x1,a
	move	a,r2
	move	x:JUNK,x1		; its feedback's
	move	#>3,y1
	mpy	x1,y1,a
	asr	a
	move	a0,a
	move	#>FB,x1
	add	x1,a
	move	a,r3
	move	#C_CNT,n1
	jsr	rd			; cnt
	move	x0,x:(r1+n1)
	jsr	rd			; the feedback's factor
	move	x0,x:(r3)
	jsr	rd			; left, right
	move	x0,y:(r2)+
	jsr	rd
	move	x0,y:(r2)
	move	#C_DW,n1
	jsr	rd			; dw
	move	x0,x:(r1+n1)
	jmp	sethall

; KEY i, ev: on, its phase 0, its attack (or its decay with no attack), the
; channel live; off, its release (unless off)
hc_key	jsr	opblk
	jsr	rd
	move	x0,a
	move	#>1,x1
	cmp	x1,a
	jne	koff
	clr	a
	move	a,x:(r1)		; the phase
	move	#O_ARF,n0
	nop
	move	x:(r0+n0),a
	tst	a
	jeq	kdec
	move	#e_att,r3
	jsr	setinc
	jmp	klive
kdec	clr	a
	move	#O_ATT,n0
	nop
	move	a,x:(r0+n0)		; att 0
	move	#e_dec,r3
	jsr	setinc
klive	move	x:JUNK,a		; the channel: i / 2, its block's live
	lsr	a
	move	a1,x1
	move	#>8,y1
	mpy	x1,y1,a
	asr	a
	move	a0,a
	move	#>CHS+C_LIVE,x1
	add	x1,a
	move	a,r1
	move	#>1,x1
	move	x1,x:(r1)
	jmp	sethall
koff	move	x:(r0),a
	move	#>e_off,x1
	cmp	x1,a
	jeq	kx
	move	#e_rel,r3
	jmp	setinc
kx	rts

; LFO: the tremolo's step, the vibrato's, the tremolo deep
hc_lfo	jsr	rd
	move	x0,x:<AMS
	jsr	rd
	move	x0,x:<PMS
	jsr	rd
	move	#>AMT,a
	jclr	#0,x0,hl1
	move	#>AMT+256,a
hl1	move	a,x:<AMD
	rts

; RHY: the rhythm mode on, the noise's steps a sample
hc_rhy	jsr	rd
	move	x0,x:<RHY
	jsr	rd
	move	x0,x:<NSTEPS
	jmp	sethall

; each channel's handler: FM's, both out's, a four-operator pair's two
; their algorithm's (each live with the other's operators too), or the
; silent one's (no operator live); in
; the rhythm mode channel 6's the bass drum's, 7's the drums', 8's none
sethall	move	#CHS,r5
	move	#HND0,r1
	move	#2,n1
	move	#>sil,y1
	do	x:<NUCH,shl
	move	#C_CNT,n5
	nop
	move	x:(r5+n5),b		; cnt
	move	x:(r5),a		; live
	move	#>fmh,x0
	tst	b
	jeq	sh9
	move	#>addh,x0
	move	#>1,x1
	cmp	x1,b
	jeq	sh9
	move	#>6,x1
	cmp	x1,b
	jge	sh7			; (a pair's second)
	move	#24,n5			; a pair's first: live with its second too (3 on)
	nop
	move	x:(r5+n5),x1
	or	x1,a
	move	#>fmlink,x0		; its algorithm's: 0 fmlink, 1 FM, 2 and 3 outlink
	move	#>2,x1
	cmp	x1,b
	jeq	sh9
	move	#>fmh,x0
	move	#>3,x1
	cmp	x1,b
	jeq	sh9
	move	#>outlink,x0
	jmp	sh9
sh7	move	#>$ffe8,n5		; a pair's second: live with its first too (3 back)
	nop
	move	x:(r5+n5),x1
	or	x1,a
	move	#>fmh,x0		; its algorithm's: 0 and 2 fmin, 1 FM (no feedback), 3 addin
	move	#>7,x1
	cmp	x1,b
	jeq	sh9
	move	#>addin,x0
	move	#>9,x1
	cmp	x1,b
	jeq	sh9
	move	#>fmin,x0
sh9	tst	a
	jne	sh10
	move	y1,x0			; (not live: silent)
sh10	move	x0,x:(r1)+n1
	move	#8,n5
	nop
	move	(r5)+n5
shl
	move	#>mix,x1		; the last's next: the mix
	move	x1,x:VT+34
	jset	#0,x:<NCH,sh11
	move	x1,x:VT+16
sh11
	jclr	#0,x:<RHY,shx
	move	#CHS+8*6,r5
	nop
	move	x:(r5)+,a
	move	x:(r5)+,b
	move	#>bdfm,x0
	move	#>bdadd,x1
	tst	b
	tne	x1,b
	teq	x0,b
	tst	a
	teq	y1,b
	move	b1,x:VT+10
	move	#>drums,x1
	move	x1,x:VT+12
	move	#>nul,x1
	move	x1,x:VT+14
shx	rts

; ---- the update (each OPL_UPD samples): the tremolo, the vibrato; each
; channel's vibrato; each operator's envelope (its mode's handler), its
; gain, its step with the vibrato's; each channel live or not (an operator
; not off). In the operators' loop: x0 the vibrato, y0 the tremolo, y1
; $800, r5 the gains' table, n3 live, n2 9
update	move	#>OPL_UPD*$10000,a
	move	a,x:<UPD
	move	x:<AMP,a		; the tremolo: its phase on, its top 8 bits
	move	x:<AMS,x1
	add	x1,a
	move	a1,x:<AMP
	move	a1,x1
	move	#>$80,y1		; (x 2^-16: -128..127, modulo 256)
	mpy	y1,x1,a
	move	a1,n3
	move	x:<AMD,r3
	movec	#$ff,m3
	nop
	move	x:(r3+n3),x1
	move	x1,x:<AMTV
	move	x:<PMP,a		; the vibrato: its top 3 bits
	move	x:<PMS,x1
	add	x1,a
	move	a1,x:<PMP
	move	a1,x1
	move	#>$4,y1			; (x 2^-21: -4..3, modulo 8)
	mpy	y1,x1,a
	move	a1,n3
	move	#PMWT,r3
	movec	#7,m3
	nop
	move	x:(r3+n3),x1
	move	x1,x:<PMWV
	movec	#$ffff,m3
	move	#OPS,r2
	move	#CHX+1,r0		; the gains
	move	#CHY,r1			; the steps (Y)
	move	#CHS,r3
	move	r3,x:<CHSP
	move	#GAIN,r5
	move	#2,n0
	move	#2,n1
	move	#9,n2
	move	x:<AMTV,y0
	do	x:<NUCH,uch
	move	x:<CHSP,r3
	move	#C_DW,n3
	move	x:<PMWV,x1
	move	x:(r3+n3),y1		; the vibrato: pmw x dw
	mpy	y1,x1,a
	move	a1,x0
	move	#0,n3
	move	#>$800,y1
	do	#2,uop
	move	x:(r2)+,r3		; its mode
	move	x:(r2)+,x1		; its increment
	move	x:(r2)+,b		; sl
	move	x:(r2),a		; att
	jmp	(r3)
e_sus	add	x1,a
tail	move	x:<ATTM,x1		; (at most the top)
	cmp	x1,a	r3,n3		; (live)
	tgt	x1,a
	move	a1,x:(r2)+		; att
	move	a1,x1
	mpy	y1,x1,b	x:(r2)+,x1	; x $800 (half steps); tl
	add	x1,b
	jclr	#0,x:(r2)+,tn		; am: the tremolo on it
	add	y0,b
tn	move	b1,n5
	jclr	#0,x:(r2)+,tnv		; vib
	move	x:(r5+n5),x1		; its gain
	move	x1,x:(r0)+n0
	move	x:(r2)+n2,x1		; its step (the next block)
	mpy	x1,x0,b			; step x vib, + step
	add	x1,b
	move	b1,y:(r1)+n1
	jmp	uend
tnv	move	x:(r5+n5),x1
	move	x1,x:(r0)+n0
	move	x:(r2)+n2,x1
	move	x1,y:(r1)+n1
uend	nop			; (jumped to: not the loop's last)
	nop
uop
	move	n3,x1			; the channel's live; the next block
	move	x:<CHSP,r3
	nop
	move	x1,x:(r3)
	move	#8,n3
	nop
	move	(r3)+n3
	move	r3,x:<CHSP
uch
	move	x:<LCHG,a		; the handlers chosen again only where a channel
	lsr	a			; may have gone silent (live 0 the update after an
	move	a1,x:<LCHG		; operator went off); a key, a channel's or the
	jcs	sethall			; rhythm mode's change chooses them at once
	rts

; the envelope's modes: r2 the block's att, x1 the mode's increment, b sl,
; a att; a the new att, to tail (r3 the mode)
e_att	move	x:<AK,b			; (att + 4.5 steps) x arf - 4.5 steps
	add	b,a
	move	a1,y1
	mpy	y1,x1,a
	move	a1,x1
	tfr	x1,a			; (its top word)
	sub	b,a
	move	#>$800,y1
	jgt	tail
	clr	a			; (at the top: the decay)
	move	#e_dec,r3
	move	#O_D1-O_ATT,n2
	jsr	trans
	jmp	tail
e_dec	add	x1,a
	cmp	b,a
	jlt	tail
	tfr	b,a			; (the sustain level: the sustain)
	move	#e_sus,r3
	move	#O_D2-O_ATT,n2
	jsr	trans
	jmp	tail
e_rel	add	x1,a	x:<ATTM,x1
	cmp	x1,a
	jlt	tail
	move	#e_off,r3		; (at the top: off)
	move	#O_RR-O_ATT,n2
	jsr	trans
	bset	#1,x:<LCHG		; (its channel maybe silent at the next update)
	jmp	tail
e_off	move	(r0)+n0			; (passed over)
	move	(r1)+n1
	move	(r2)+n2			; (att + 13: the next block)
	move	(r2)+
	move	(r2)+
	move	(r2)+
	move	(r2)+
	jmp	uend

; a change of mode: r3 the new, n2 its increment's place from the att;
; stored with it (r2 the att; n2 9 again)
trans	move	x:(r2+n2),x1
	move	#O_INC-O_ATT,n2
	nop
	move	x1,x:(r2+n2)
	move	#O_MODE-O_ATT,n2
	nop
	move	r3,x:(r2+n2)
	move	#9,n2
	rts


; ---- RUN n: n samples, each its left and right to the host
c_run	jsr	rd
	do	x0,run1
	jsr	sample
	jsr	wr
	tfr	b,a
	jsr	wr
	nop
run1
	jmp	cmd
wr	jclr	#1,x:HSR,wr
	movep	a,x:HTX
	rts

; ---- RESET: all silent
c_reset	clr	a
	move	#0,r0
	rep	#$100			; internal X: the state
	move	a,x:(r0)+
	move	#0,r0
	rep	#$100			; internal Y: the gains, the steps, the waveforms
	move	a,y:(r0)+
	move	#>1,x1
	move	x1,x:<NSTEPS
	move	#>$10000,x1		; (an update at the first sample)
	move	x1,x:<UPD
	move	#>$1000,x1
	move	x1,x:<K1000
	move	#>2,x1			; (the noise's 1, x 2)
	move	x1,x:<NOISE
	move	#>$3ff,x1
	move	x1,x:<MASK
	move	#>AKOFF,x1
	move	x1,x:<AK
	move	#>ATTMAX,x1
	move	x1,x:<ATTM
	move	#>AMT,x1
	move	x1,x:<AMD
	move	#>9,x1			; nine channels made, updated
	move	x1,x:<NUCH
	move	#CHY+1,r0		; each operator's waveform: the sine
	move	#>WAVE,x1
	do	#36,rs0
	move	x1,y:(r0)+
	move	(r0)+
rs0
	move	#OPS,r0			; each operator: off, att at the top
	move	#>ATTMAX,x1
	move	#>e_off,y1
	do	#36,rs1
	move	y1,x:(r0)+
	rep	#2
	move	a,x:(r0)+
	move	x1,x:(r0)+
	rep	#12
	move	a,x:(r0)+
rs1
	move	#CHS,r0			; each channel: not live, FM
	rep	#144
	move	a,x:(r0)+
	jsr	sethall			; (each silent; the mix after the ninth)
	jmp	cmd

; ---- PLAY: the SSI on, the ring kept LEAD words ahead, the commands taken
; between samples
c_play	jsr	rd			; k: 1, 2 (each sample twice) or 3
	move	x0,x:<PLX
	clr	a
	move	a,x:<PREVL
	move	a,y:<PREVR
	move	#>2047,x1
	move	x1,x:<MINLD
	bclr	#0,x:<PFULL
	clr	a
	move	#RING,r6
	movec	#2047,m6
	rep	#2048
	move	a,y:(r6)+
	move	#RING,r7
	movec	#2047,m7
	movep	#$1f8,x:PCC		; port C: the SSI
	movep	#$4100,x:CRA		; 16 bits, 2 words a frame
	movep	#$5800,x:CRB		; transmit and its interrupt, network mode
	movep	#$3000,x:IPR		; the SSI at level 2, the host's off
	movep	#0,x:TX
pmt	jclr	#6,x:SSISR,pmt
	jclr	#2,x:SSISR,pmr
	movep	#0,x:TX
pmt2	jclr	#6,x:SSISR,pmt2
pmr	andi	#$fc,mr			; interrupts on: the left first
ploop	jclr	#0,x:HSR,pgen0
	jsr	rd
	jsr	hcmd
	jmp	ploop
pgen0	jset	#3,x:HSR,ploop		; (HF0: a burst of commands still coming)
pgen	move	r6,a
	move	r7,x0
	sub	x0,a
	move	#>2047,x1
	and	x1,a
	move	a1,y1
	move	y1,a
	jclr	#0,x:<PFULL,pg0		; (its least, once it has filled: not the start)
	move	x:<MINLD,x1
	cmp	x1,a
	jge	pg1
	move	a1,x:<MINLD
	jmp	pg1
pg0	move	#>LEAD,x0
	cmp	x0,a
	jlt	pg1
	bset	#0,x:<PFULL
pg1	move	#>LEAD,x0
	cmp	x0,a
	jge	ploop
	jsr	sample
	jclr	#1,x:<PLX,pone
	jset	#0,x:<PLX,pthree
	move	a,x1			; twice: first halfway from the one before
	move	x:<PREVL,y1
	move	x1,x:<PREVL
	move	a,y0
	tfr	y1,a
	add	y0,a
	asr	a
	move	a,y:(r6)+
	move	b,x1
	move	y:<PREVR,y1
	move	x1,y:<PREVR
	move	b,y0
	tfr	y1,b
	add	y0,b
	asr	b
	move	b,y:(r6)+
	move	x:<PREVL,a
	move	y:<PREVR,b
pone	move	a,y:(r6)+
	move	b,y:(r6)+
	jmp	ploop
pthree	move	a,x1			; three times: a third, two thirds, the sample
	move	x:<PREVL,y1
	move	x1,x:<PREVL
	sub	y1,a
	move	a,x0
	move	#>$2aaaab,y0		; (1/3)
	mpy	x0,y0,a
	move	a,x0
	tfr	y1,a
	add	x0,a
	move	a,x:<T3L1
	add	x0,a
	move	a,x:<T3L2
	move	b,x1
	move	y:<PREVR,y1
	move	x1,y:<PREVR
	sub	y1,b
	move	b,x0
	mpy	x0,y0,b
	move	b,x0
	tfr	y1,b
	add	x0,b
	move	x:<T3L1,a
	move	a,y:(r6)+
	move	b,y:(r6)+
	add	x0,b
	move	x:<T3L2,a
	move	a,y:(r6)+
	move	b,y:(r6)+
	move	x:<PREVL,a
	move	y:<PREVR,b
	jmp	pone
