;
; synth.a56 - the MP3 decode's synthesis filter on the Falcon's DSP56001:
; a granule of one channel's 32 x 18 subband samples into 576 samples, as
; src/mp3/mp3dsp.c's synth() does, bit for bit. On its own here, behind a
; test protocol (tests/dspsynth); it goes into dsp/mp3.a56 as it is.
;
; The host's words: 1 LOADX ADDR N then N words into X; 4 LOADY the same
; into Y; 5 RESET (both channels' V to zero); 3 SYNTH CH then the 576
; subband samples (subband-major: sample k*18 + t is subband k at slot t).
; SYNTH answers 1 (ready), works, answers 2 (done), then sends the 576
; samples.
;
; Each slot: the butterfly e[k] = x[k] + x[31-k], o[k] = x[k] - x[31-k];
; the DCT's 32 rows (X[n] from e for even n, from o for odd), each written
; to V twice (V[48+n] and V[48-n], minus, for n < 16; V[n-16], and minus
; at V[48-n], from 16), V[16] = 0. V is a ring of 16 slots of 64 words, a
; channel's 1024; in odd slots the two halves are swapped, so that every
; tap of an output is 64 words before the last: the window's 16 taps of
; output j are at a fixed row, slot after slot. Outputs j and 32 - j share
; their window's values (D[32 - j + 32t] = -D[j + 32(15 - t)]), so they
; are worked out together, the values read once from internal Y.

HSR	equ	$ffe9
HRX	equ	$ffeb

V_CH	equ	$20		; X internal: the channel
V_T	equ	$21		; the slot (0..17)
V_P	equ	$22		; the ring's slot (0..15) of this channel
V_RING	equ	$23		; the ring's start
V_SW	equ	$24		; 32 in odd slots, else 0
V_POS	equ	$26		; X: each channel's ring slot (2 words)
V_START	equ	$28		; X: this slot's start in the ring

EO	equ	$0000		; X internal: e[0..15], o[0..15] (modulo 32)
DPAIR	equ	$0000		; Y internal: for j = 1..15, D[j + 32t], t = 0..15: 16 a j
DCT	equ	$2000		; Y: the DCT's rows, 16 a row
D016	equ	$2200		; Y: D[32t] (17 words) then D[16 + 32t] (17)
RING0	equ	$2000		; X: channel 0's V (1024, aligned)
RING1	equ	$2400		; X: channel 1's
SBS	equ	$2800		; X: the subband samples
OUT	equ	$2c00		; X: the samples out

	org	p:$0
	jmp	start

	org	p:$2			; (no interrupts: the vectors are free)
start
	movep	#1,x:$ffe0		; port B is the host port
	movep	#0,x:$fffe		; no wait states
	ori	#3,mr			; no interrupts
	movec	#$ffff,m0		; linear (not #-1: a56 makes that 8 bits, $ff)
	movec	m0,m1
	movec	m0,m2
	movec	m0,m3
	movec	m0,m4
	movec	m0,m5
	movec	m0,m6
	movec	m0,m7
	jsr	zring

cmd	jsr	rd
	move	x0,a
	move	#>1,x1
	cmp	x1,a
	jeq	loadx
	move	#>4,x1
	cmp	x1,a
	jeq	loady
	move	#>3,x1
	cmp	x1,a
	jeq	synth
	move	#>5,x1
	cmp	x1,a
	jne	cmd
	jsr	zring
	jmp	cmd

loadx	jsr	rd
	move	x0,r0
	jsr	rd
	do	x0,lx
	jsr	rd
	move	x0,x:(r0)+
lx
	jmp	cmd

loady	jsr	rd
	move	x0,r0
	jsr	rd
	do	x0,ly
	jsr	rd
	move	x0,y:(r0)+
ly
	jmp	cmd

zring	clr	a
	move	#>RING0,r0
	do	#2048,rs
	move	a,x:(r0)+
rs
	move	a,x:V_POS
	move	a,x:V_POS+1
	rts

synth	jsr	rd
	move	x0,x:V_CH
	move	#>SBS,r0
	do	#576,ss
	jsr	rd
	move	x0,x:(r0)+
ss
	move	#>1,x1
	jsr	wr			; ready
	jsr	gran
	move	#>2,x1
	jsr	wr			; done
	move	#>OUT,r0
	do	#576,so
	move	x:(r0)+,x1
	jsr	wr
so
	jmp	cmd

; ---- a granule: SBS to OUT, channel V_CH
gran	move	x:V_CH,n0
	move	#>V_POS,r0
	nop
	move	x:(r0+n0),x0
	move	x0,x:V_P
	move	#>RING0,x0
	move	x:V_CH,b
	tst	b
	jeq	gr0
	move	#>RING1,x0
gr0	move	x0,x:V_RING
	clr	a
	move	a,x:V_T
	move	#>OUT,r0		; r0: the samples out, all the way
	do	#18,grs
	jsr	slot
	move	x:V_T,b
	move	#>1,x0
	add	x0,b
	move	b1,x:V_T
grs
	move	x:V_CH,n1
	move	#>V_POS,r1
	move	x:V_P,x0
	move	x0,x:(r1+n1)
	rts

; ---- a slot: the next ring slot from the subband samples at slot V_T
slot	move	x:V_P,b			; the ring's next slot
	move	#>1,x0
	add	x0,b
	move	#>15,x0
	and	x0,b
	move	b1,x:V_P
	clr	a
	jclr	#0,b1,sl0
	move	#>32,a
sl0	move	a1,x:V_SW
	; the butterfly: x[k] = SBS + 18k + t
	move	#>SBS,b
	move	x:V_T,x0
	add	x0,b
	move	b1,r1
	move	#>31*18,x0
	add	x0,b
	move	b1,r3
	move	#>18,n1
	move	#>-18,n3
	move	#>EO,r2			; e
	move	#>EO+16,r6		; o (in X: a single move takes any register)
	do	#16,bf
	move	x:(r1)+n1,a
	tfr	a,b		x:(r3)+n3,x0
	add	x0,a
	sub	x0,b		a,x:(r2)+
	move	b,x:(r6)+
bf
	; this slot's start in the ring: RING + 64 V_P
	move	x:V_P,x0
	move	#>64,y0
	mpy	x0,y0,b
	asr	b
	move	b0,b
	move	x:V_RING,x0
	add	x0,b			; the slot's start
	move	b1,x:V_START
	; X[0..15]: minus, to rows 48 + n and 48 - n
	move	x:V_SW,x0
	move	#>48,a
	add	x0,a
	move	#>63,x0
	and	x0,a
	add	b,a			; (the start: a multiple of 64)
	move	a1,r2
	move	a1,r3
	movec	#63,m2
	movec	#63,m3
	move	#>EO,r1
	movec	#31,m1
	move	#>DCT,r5
	do	#16,dl
	clr	a		x:(r1)+,x0	y:(r5)+,y0
	rep	#15
	mac	x0,y0,a		x:(r1)+,x0	y:(r5)+,y0
	macr	x0,y0,a
	neg	a
	move	a,x:(r2)+
	move	a,x:(r3)-
dl
	; X[16..31]: to row n - 16, and minus to row 48 - n
	move	x:V_START,b
	move	x:V_SW,x0
	move	x0,a
	add	b,a
	move	a1,r2			; row 0
	move	#>32,a
	add	x0,a
	move	#>63,x0
	and	x0,a
	add	b,a
	move	a1,r3			; row 32
	do	#16,dh
	clr	a		x:(r1)+,x0	y:(r5)+,y0
	rep	#15
	mac	x0,y0,a		x:(r1)+,x0	y:(r5)+,y0
	macr	x0,y0,a
	move	a,x:(r2)+
	neg	a
	move	a,x:(r3)-
dh
	; V[16] = 0
	move	x:V_SW,x0
	move	#>16,a
	add	x0,a
	move	#>63,x0
	and	x0,a
	add	b,a
	move	a1,r2
	clr	a
	move	a,x:(r2)
	movec	#$ffff,m1
	movec	#$ffff,m2
	movec	#$ffff,m3
	; the window. The ring modulo 1024, a tap 64 words before the last
	movec	#1023,m1
	movec	#1023,m2
	move	#>-64,n1
	move	#>64,n2
	; output 0 (row 0) and 16 (row 16): their own values in external Y
	move	x:V_SW,x0
	tfr	b,a
	move	#>D016,r6
	add	x0,a			; row 0 of this slot
	move	a1,r1
	nop
	clr	a		x:(r1)+n1,x0	y:(r6)+,y0
	rep	#15
	mac	x0,y0,a		x:(r1)+n1,x0	y:(r6)+,y0
	mac	x0,y0,a		(r6)+
	asl	a
	asl	a
	rnd	a
	move	a,x:(r0)
	move	x:V_SW,x0
	move	#>16,a
	add	x0,a
	move	#>63,x0
	and	x0,a
	add	b,a			; row 16
	move	a1,r1
	nop
	clr	a		x:(r1)+n1,x0	y:(r6)+,y0
	rep	#15
	mac	x0,y0,a		x:(r1)+n1,x0	y:(r6)+,y0
	mac	x0,y0,a
	asl	a
	asl	a
	rnd	a
	move	#>16,n3
	move	r0,r3
	nop
	move	a,x:(r3+n3)
	; outputs j and 32 - j, j = 1..15. j's taps from this slot back, at
	; row j; 32 - j's from 15 slots back forward, at row 32 - j
	move	x:V_SW,x0
	move	#>1,a
	add	x0,a
	add	b,a
	move	a1,r1			; row 1 of this slot
	; slot P - 15 = P + 1: start + 64, in the ring
	move	x:V_SW,x0
	move	#>31,a
	add	x0,a
	move	#>63,x0
	and	x0,a
	move	#>64,x0
	add	x0,a
	add	b,a
	move	x:V_RING,x0
	sub	x0,a
	move	#>1023,x0
	and	x0,a
	move	x:V_RING,x0
	add	x0,a
	move	a1,r2			; row 31 of slot P - 15
	move	#>DPAIR,r5
	move	r0,r3
	move	#>1,n0
	move	#>32,n3
	move	(r0)+n0			; r0: output j
	move	(r3)+n3			; r3: output 32 - j (one past; decremented first)
	do	#15,pj
	clr	a		x:(r1)+n1,x0	y:(r5)+,y0
	clr	b		x:(r2)+n2,x1
	do	#15,pt
	mac	x0,y0,a		x:(r1)+n1,x0
	mac	-x1,y0,b	x:(r2)+n2,x1	y:(r5)+,y0
pt
	mac	x0,y0,a				; the 16th tap: 16 reads, the pointers
	mac	-x1,y0,b			; back where they began (1024 round)
	asl	a		(r1)+		; row j + 1 of this slot
	asl	a		(r2)-		; row 31 - j of slot P - 15
	rnd	a
	asl	b		a,x:(r0)+
	asl	b		(r3)-
	rnd	b
	move	b,x:(r3)
pj
	movec	#$ffff,m1
	movec	#$ffff,m2
	move	#>16,n0
	nop
	move	(r0)+n0			; the next slot's samples
	rts

; host port
rd	jclr	#0,x:HSR,rd
	movep	x:HRX,x0
	rts
wr	jclr	#1,x:HSR,wr
	movep	x1,x:HRX
	rts
