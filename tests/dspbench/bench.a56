; Copyright (C) 2026 AERA | Erez Yaary
;
; bench.a56 - what the two heaviest parts of an MP3 decode cost the
; Falcon's DSP56001: the synthesis filter and the inverse transform, for
; one channel of one granule (576 samples), with the data laid out as the
; Falcon's memory has it (internal X and Y 256 words each, external X and
; Y 16K each, P over both). The tables hold zeros: the loops take the same
; time whatever the numbers. tests/dspbench/sim.c counts the cycles
; between the words the program sends at each mark.
;
; The synthesis is the 32 x 32 matrix (the 64 values of the standard
; filter have 32 different ones, up to sign) and the 512-tap window, 16
; taps an output; the transform is the 18 x 18 matrix of the 36-point
; IMDCT's 18 different outputs, then the window and the overlap.

HSR	equ	$ffe9
HRX	equ	$ffeb

S	equ	$0000		; X int: 32 subband samples of one slot
T	equ	$0040		; X int: 18 inputs of one subband
U	equ	$0060		; X int: its 18 transform values
WINT	equ	$0000		; Y int: a window table held inside (variant 2)
CTAB	equ	$0000		; Y ext ($200..): the 32 x 32 matrix
WTAB	equ	$0800		; Y ext: the 512 window taps
ITAB	equ	$0c00		; Y ext: the 18 x 18 transform matrix
IWIN	equ	$0e00		; Y ext: the 36 window values
VBUF	equ	$2000		; X ext: V, 16 slots of 32, modulo 512
OVL	equ	$2400		; X ext: the overlap, 32 x 18
OUT	equ	$2800		; X ext: the 576 samples out
TMP	equ	$1000		; Y ext: the transform's output

	org	p:$0
	jmp	start

	org	p:$40
start
	movep	#1,x:$ffe0		; port B is the host port
	movep	#0,x:$fffe		; no wait states
	ori	#3,mr			; no interrupts
	movec	#$ffff,m0		; linear (not #-1: a56 makes that 8 bits, $ff)
	movec	m0,m1
	movec	m0,m2
	movec	m0,m3
	movec	m0,m4
	movec	m0,m5
	movec	m0,m6
	movec	m0,m7
	jsr	mark

; ---- 1. synthesis, window in external Y
	move	#VBUF,r1
	movec	#$1ff,m1
	move	#OUT,r6
	do	#18,syn1
	jsr	matrix
	move	#32,n1
	move	#WTAB,r5
	do	#32,w1
	clr	a	x:(r1)+n1,x0	y:(r5)+,y0
	rep	#15
	mac	x0,y0,a	x:(r1)+n1,x0	y:(r5)+,y0
	macr	x0,y0,a	(r1)+
	move	a,x:(r6)+
w1
	nop
syn1
	jsr	mark

; ---- 2. synthesis, window taps inside (as if 256 of them in Y int)
	move	#OUT,r6
	do	#18,syn2
	jsr	matrix
	move	#32,n1
	move	#WINT,r5
	movec	#$ff,m5
	do	#32,w2
	clr	a	x:(r1)+n1,x0	y:(r5)+,y0
	rep	#15
	mac	x0,y0,a	x:(r1)+n1,x0	y:(r5)+,y0
	macr	x0,y0,a	(r1)+
	move	a,x:(r6)+
w2
	nop
syn2
	movec	#$ffff,m5
	jsr	mark

; ---- 3. the inverse transform, window and overlap: 32 subbands
	move	#OVL,r3
	move	#OUT,r6
	do	#32,imd
	move	#T,r0
	movec	#17,m0
	move	#ITAB,r4
	move	#U,r2
	do	#18,irow
	clr	a	x:(r0)+,x0	y:(r4)+,y0
	rep	#17
	mac	x0,y0,a	x:(r0)+,x0	y:(r4)+,y0
	macr	x0,y0,a
	move	a,x:(r2)+
irow
	movec	#$ffff,m0		; linear (not #-1: a56 makes that 8 bits, $ff)
	move	#U,r2
	move	#IWIN,r5
	; first 18: the overlap kept from the last granule plus this one's
	do	#18,iw1
	move	x:(r2)+,x0	y:(r5)+,y0
	mpy	x0,y0,a	x:(r3),b
	add	b,a
	move	a,x:(r6)+
iw1
	; last 18: kept for the next granule
	move	#U,r2
	do	#18,iw2
	move	x:(r2)+,x0	y:(r5)+,y0
	mpyr	x0,y0,a
	move	a,x:(r3)+
iw2
	nop
imd
	jsr	mark
	jmp	*

; the 32 x 32 matrix for one slot: S (X int) times CTAB (Y ext) into V
matrix
	move	#S,r0
	movec	#31,m0
	move	#CTAB+$200,r4
	do	#32,mrow
	clr	a	x:(r0)+,x0	y:(r4)+,y0
	rep	#31
	mac	x0,y0,a	x:(r0)+,x0	y:(r4)+,y0
	macr	x0,y0,a
	move	a,x:(r1)+
mrow
	movec	#$ffff,m0		; linear (not #-1: a56 makes that 8 bits, $ff)
	rts

; tell the host we got here
mark
	jclr	#1,x:HSR,mark
	movep	#0,x:HRX
	rts
